# Copy this file to `.env` and fill in your values, then deploy.
# These are non-secret build-time params (the API key is a SECRET — see README).
#
# MAIL_FROM must be an address on the domain you authenticated in SendGrid
# (Settings → Sender Authentication → Authenticate Your Domain).
MAIL_FROM=noreply@yourschooldomain.com
MAIL_FROM_NAME=Your School Name
