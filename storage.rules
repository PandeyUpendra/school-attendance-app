rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// School App — Cloud Storage Security Rules
//
// Tenant isolation (#3): Storage rules can't read Firestore, so per-school
// assets are scoped via the `schoolId` CUSTOM CLAIM minted by the syncUserClaims
// Cloud Function (mirrored from allowed_users). A caller may only read/write
// files under their OWN school. The root admin (matched by email) may read
// across schools for support.
//
// DEPLOY ORDER: run functions/scripts/backfill_claims.js (and deploy
// syncUserClaims) BEFORE deploying these rules — a user without the schoolId
// claim is denied all per-school storage. The app forces an ID-token refresh at
// login so claims take effect promptly.
//
// Previously only `schools/{id}/policy/**` was allowed (so teacher photos and
// logos under schools/{id}/teachers|logo were actually DENIED), and reads/writes
// were open to ANY signed-in user of ANY school (cross-tenant). Both fixed here.
// ════════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // The caller's schoolId custom claim, or null when absent.
    function tokenSchoolId() {
      return isSignedIn() && 'schoolId' in request.auth.token
          ? request.auth.token.schoolId : null;
    }

    function isRootAdmin() {
      return isSignedIn()
        && (request.auth.token.email == 'mandvishal@gmail.com' || request.auth.token.email == 'admin@schoolapp.org');
    }

    // Image-only, ≤ 15 MB. resource is null on create, so guard both.
    function isAllowedImage() {
      return request.resource != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // All per-school assets: policy reference photos, teacher photos, the school
    // logo, etc. Read confined to the caller's own school (root admin exempt);
    // writes additionally must be images.
    match /schools/{schoolId}/{allPaths=**} {
      allow read:  if isRootAdmin() || tokenSchoolId() == schoolId;
      allow write: if tokenSchoolId() == schoolId && isAllowedImage();
    }

    // Everything else: denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
