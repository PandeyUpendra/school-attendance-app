      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "attendanceapp-e76e1",
          "appId": "1:501123948626:android:4463b36de03be1d231bf8b",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "attendanceapp-e76e1",
          "configurations": {
            "android": "1:501123948626:android:4463b36de03be1d231bf8b"
          }
        }
      }
    }
  }
