rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// School App — Firestore Security Rules
//
// Architecture notes
// ──────────────────
// • All user identity lives in  allowed_users/{uid}  (root, not school-scoped)
//   Fields: role, schoolId, classIds[], studentIds[], status, name, email
// • Every other collection is school-scoped: schools/{sid}/...
// • Roles: teacher · subjectTeacher · guardian · coordinator · principal
//          admin   · owner
// • Attendance doc ID  = class name string  e.g. "Class 9-A"
// • Student  doc ID    = "{cls}_{section}_{roll}" (spaces → underscores)
// • Notification audience field formats — see NOTIFICATIONS block below
//
// Hard guarantees
// ───────────────
// ① Default-deny catch-all at the top of every database match.
// ② Every school-scoped rule calls inSchool(sid) first.
// ③ Role escalation blocked: non-admin self-update cannot change role or schoolId.
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════
    // ① DEFAULT DENY — every path must carry an explicit allow.
    // ════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    //
    // userDoc() result is memoised per evaluation — multiple calls in
    // a single rule cost only ONE document-read quota unit.
    // ════════════════════════════════════════════════════════════════

    /// Firebase Auth token is present and contains an email.
    function isSignedIn() {
      return request.auth != null && request.auth.token != null && 'email' in request.auth.token;
    }

    /// Replaces spaces with underscores. Since Firestore rules do not support
    /// native string replacement (e.g. .replace()), we split and concatenate.
    function replaceSpaces(str) {
      let parts = str == null ? [] : str.split(' ');
      return str == null ? null : (
        parts.size() == 1
          ? str
          : (parts.size() == 2
              ? parts[0] + '_' + parts[1]
              : (parts.size() == 3
                  ? parts[0] + '_' + parts[1] + '_' + parts[2]
                  : (parts.size() == 4
                      ? parts[0] + '_' + parts[1] + '_' + parts[2] + '_' + parts[3]
                      : str)))
      );
    }

    function userEmail() {
      return isSignedIn() ? request.auth.token.email.lower() : '';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/allowed_users/$(request.auth.token.email.lower())).data;
    }

    /// SCALE-05: identity from CUSTOM CLAIMS instead of a document read.
    ///
    /// `syncUserClaims` (Cloud Function) mirrors {role, schoolId} from each
    /// allowed_users doc into the caller's Firebase Auth custom claims, and the
    /// app forces an ID-token refresh at login so they take effect promptly. The
    /// claim is server-signed and un-forgeable.
    ///
    /// Why this matters: EVERY role/tenant check (isRole / hasAnyRole /
    /// isManagement / isAnyStaff / inSchool) used to re-invoke getUserData() — a
    /// get() that also burns expression-evaluation budget. Firestore caps each
    /// request at 1000 expression evaluations (NOT cached), so getUserData()-
    /// heavy rules sat right at the ceiling and DENIED legitimate reads
    /// non-deterministically. Reading the claim costs no get() and a handful of
    /// expressions, so the common path no longer approaches the ceiling.
    function claimRole() {
      return isSignedIn() && 'role' in request.auth.token ? request.auth.token.role : null;
    }

    function claimSchoolId() {
      return isSignedIn() && 'schoolId' in request.auth.token ? request.auth.token.schoolId : null;
    }

    /// Caller's role string (e.g. 'teacher', 'coordinator', …). Prefers the
    /// custom claim; falls back to the allowed_users doc only when the claim has
    /// not propagated yet (legacy/just-provisioned accounts before their first
    /// post-claim token refresh).
    function userRole() {
      return claimRole() != null
        ? claimRole()
        : (getUserData() != null ? getUserData().role : null);
    }

    /// Caller's schoolId, or null when absent.
    ///
    /// PHASE 3 (strict multi-tenancy): the old 'school_1' default is GONE — a
    /// missing schoolId now fails closed (returns null → inSchool() false)
    /// rather than silently granting access to school_1. Prefers the schoolId
    /// custom claim (SCALE-05), falling back to the allowed_users doc for
    /// accounts whose claim has not propagated. REQUIRES the Phase 2 backfill
    /// (scripts/backfill_school_id.js) + claims backfill to have run.
    function userSchoolId() {
      return claimSchoolId() != null
        ? claimSchoolId()
        : (getUserData() != null && 'schoolId' in getUserData() ? getUserData().schoolId : null);
    }

    /// Caller's teacherId.
    function userTeacherId() {
      return isSignedIn() && 'teacherId' in request.auth.token
        ? request.auth.token.teacherId
        : (getUserData() != null && 'teacherId' in getUserData() ? getUserData().teacherId : null);
    }

    /// Caller's assigned classIds array.
    function userClassIds() {
      return isSignedIn() && 'classIds' in request.auth.token && request.auth.token.classIds.size() > 0
        ? request.auth.token.classIds
        : (getUserData() != null && 'classIds' in getUserData() ? getUserData().classIds : []);
    }

    /// Caller's assigned studentIds array (for guardians).
    function userStudentIds() {
      return isSignedIn() && 'studentIds' in request.auth.token && request.auth.token.studentIds.size() > 0
        ? request.auth.token.studentIds
        : (getUserData() != null && 'studentIds' in getUserData() ? getUserData().studentIds : []);
    }

    /// Guardian linkage fields actually stamped on allowed_users by the app
    /// (TimetableService.addAllowedUser): studentClass / studentRoll /
    /// studentSection. These are the SOURCE OF TRUTH for guardian scoping —
    /// the app never populates classIds[]/studentIds[] for guardians, so those
    /// must NOT be relied on for guardian access.
    function userStudentClass() {
      return isSignedIn() && 'studentClass' in request.auth.token
        ? request.auth.token.studentClass
        : (getUserData() != null && 'studentClass' in getUserData() ? getUserData().studentClass : null);
    }

    function userStudentRoll() {
      return isSignedIn() && 'studentRoll' in request.auth.token
        ? request.auth.token.studentRoll
        : (getUserData() != null && 'studentRoll' in getUserData() ? getUserData().studentRoll : null);
    }

    function userStudentSection() {
      return isSignedIn() && 'studentSection' in request.auth.token
        ? request.auth.token.studentSection
        : (getUserData() != null && 'studentSection' in getUserData() ? getUserData().studentSection : '');
    }

    /// Caller's child's STABLE admission id (#39). Stamped on the guardian's
    /// allowed_users doc at provisioning. Unlike studentRoll, it never changes
    /// across promotion / roll reuse, so notifications addressed to
    /// 'guardian_adm:{admissionId}' can never be inherited by a later student
    /// who reuses the vacated class+roll. Returns null when absent (legacy
    /// guardians) so the admissionId audience branch simply never matches.
    function userStudentAdmissionId() {
      return isSignedIn() && 'studentAdmissionId' in request.auth.token
        ? request.auth.token.studentAdmissionId
        : (getUserData() != null && 'studentAdmissionId' in getUserData() ? getUserData().studentAdmissionId : null);
    }

    /// The student document ID for the caller's own child:
    /// "{studentClass}_{studentSection}_{studentRoll}" (spaces → underscores),
    /// matching how the app builds student doc IDs. Used to scope guardian
    /// access to subcollections that carry no className/roll fields.
    function guardianStudentId() {
      return userStudentSection() == '' || userStudentSection() == null
        ? replaceSpaces(userStudentClass()) + '_' + string(userStudentRoll())
        : replaceSpaces(userStudentClass()) + '_' + replaceSpaces(userStudentSection()) + '_' + string(userStudentRoll());
    }

    /// True when caller's role exactly equals r.
    function isRole(r) {
      return userRole() == r;
    }

    /// ② True when the caller's schoolId matches path variable sid.
    ///
    /// PHASE 3 (strict multi-tenancy): real tenant isolation. Previously this
    /// returned true whenever sid=='school_1' OR userSchoolId()=='school_1'
    /// (which defaulted on), AND for any 'owner' regardless of school — so a
    /// second school was fully exposed and any owner could reach any school
    /// (review #12). Now ONLY the hardcoded root admin crosses schools; everyone
    /// else (owners included) is confined to their own schoolId. Requires the
    /// Phase 2 backfill to have run.
    function inSchool(sid) {
      return isRootAdmin() || userSchoolId() == sid;
    }

    /// Optimized notifications read permission helper.
    /// Uses let bindings to evaluate getUserData() exactly once, preventing
    /// the 1000 expression ceiling evaluation limit from being reached.
    function canReadNotification(sid, audience) {
      let userData = getUserData();
      let role = userData != null ? userData.role : null;
      let schoolId = userData != null && 'schoolId' in userData ? userData.schoolId : null;
      return isRootAdmin() || (
        userData != null && schoolId == sid && (
          // Broadcast is always allowed
          audience == 'all' ||
          
          // Staff path
          (role in ['teacher', 'subjectTeacher', 'coordinator', 'principal', 'admin', 'owner', 'ownerPrincipal'] && (
            (audience == 'teachers' && role in ['teacher', 'subjectTeacher']) ||
            (audience == 'coordinator' && role == 'coordinator') ||
            (audience == 'principal' && role == 'principal') ||
            (role in ['teacher', 'subjectTeacher'] && (
              ('teacherId' in userData && userData.teacherId != null && audience == 'teacher:' + userData.teacherId) ||
              audience.matches('class:.*') ||
              (audience.matches('class_teacher:.*') && 'classIds' in userData && audience.split(':')[1] in userData.classIds)
            ))
          )) ||
          
          // Guardian path
          (role == 'guardian' && (
            audience == 'guardians' ||
            (audience.matches('guardian:.*:.*') &&
             resource != null && 'targetStudentId' in resource.data && (
               ('studentIds' in userData && resource.data.targetStudentId in userData.studentIds) ||
               resource.data.targetStudentId == guardianStudentId()
             )
            ) ||
            ('studentAdmissionId' in userData && userData.studentAdmissionId != null &&
             audience.matches('guardian_adm:.*') &&
             audience.split(':')[1] == userData.studentAdmissionId) ||
            (audience.matches('class:.*') && (
             ('classIds' in userData && audience.split(':')[1] in userData.classIds) ||
             ('studentClass' in userData && audience.split(':')[1] == userData.studentClass)
            ))
          ))
        )
      );
    }

    /// Optimized exam results read permission helper.
    /// Uses let bindings to evaluate getUserData() exactly once, preventing
    /// the 1000 expression ceiling evaluation limit from being reached.
    function canReadExamResult(sid, roll, targetStudentId) {
      let userData = getUserData();
      let role = userData != null ? userData.role : null;
      let schoolId = userData != null && 'schoolId' in userData ? userData.schoolId : null;
      return isRootAdmin() || (
        userData != null && schoolId == sid && (
          // Staff can read all exam results
          role in ['teacher', 'subjectTeacher', 'coordinator', 'principal', 'admin', 'owner', 'ownerPrincipal'] ||
          
          // Guardian: only their own child's result
          (role == 'guardian' && (
            (targetStudentId != null && 'studentIds' in userData && targetStudentId in userData.studentIds) ||
            ('studentRoll' in userData && roll == string(userData.studentRoll) &&
             targetStudentId != null &&
             targetStudentId == (
               !('studentSection' in userData) || userData.studentSection == '' || userData.studentSection == null
                 ? replaceSpaces(userData.studentClass) + '_' + string(userData.studentRoll)
                 : replaceSpaces(userData.studentClass) + '_' + replaceSpaces(userData.studentSection) + '_' + string(userData.studentRoll)
             )
            )
           ))
        )
      );
    }

    /// Optimized per-student-attendance read permission helper (H2).
    /// Same let-binding discipline as canReadExamResult: getUserData() is
    /// evaluated exactly ONCE so a guardian read does not blow the 1000-
    /// expression ceiling (SCALE-05). Staff read any student in their school;
    /// a guardian reads only the mirror doc whose id is their own child's.
    function canReadStudentAttendance(sid, studentId) {
      let userData = getUserData();
      let role = userData != null ? userData.role : null;
      let schoolId = userData != null && 'schoolId' in userData ? userData.schoolId : null;
      return isRootAdmin() || (
        userData != null && schoolId == sid && (
          role in ['teacher', 'subjectTeacher', 'coordinator', 'principal', 'admin', 'owner', 'ownerPrincipal'] ||
          (role == 'guardian' && (
             ('studentIds' in userData && studentId in userData.studentIds) ||
             ('studentClass' in userData && 'studentRoll' in userData &&
              studentId == (
                !('studentSection' in userData) || userData.studentSection == '' || userData.studentSection == null
                  ? replaceSpaces(userData.studentClass) + '_' + string(userData.studentRoll)
                  : replaceSpaces(userData.studentClass) + '_' + replaceSpaces(userData.studentSection) + '_' + string(userData.studentRoll)
              )
             )
          ))
        )
      );
    }

    /// M1: which notification audiences a TEACHER may author. Binds
    /// userClassIds() exactly ONCE (let) to stay under the expression ceiling.
    /// A teacher may post to staff-workflow channels (coordinator / principal /
    /// teacher:*) and the opaque stable-id student channel (guardian_adm:*), but
    /// any CLASS- or GUARDIAN-targeted audience must name a class the teacher
    /// actually teaches. This stops a teacher from blasting a notice/push to a
    /// parent (or a whole class) OUTSIDE their own classes — previously any
    /// teacher could target guardian:<anyClass>:<anyRoll> with arbitrary
    /// title/body, a school-wide impersonation/phishing vector (M1).
    function teacherMayPostAudience(aud) {
      let ids = userClassIds();
      return aud is string && (
        aud == 'coordinator' || aud == 'principal' ||
        aud.matches('teacher:.*') ||
        aud.matches('guardian_adm:.*') ||
        (aud.matches('class:.*')         && aud.split(':')[1] in ids) ||
        (aud.matches('class_teacher:.*') && aud.split(':')[1] in ids) ||
        (aud.matches('guardian:.*:.*')   && aud.split(':')[1] in ids)
      );
    }

    /// True when cls is listed in the caller's classIds array.
    ///
    /// IMPORTANT — keep this cheap (a single field test, no get()/exists()).
    /// An earlier version added a cross-document fallback that read the
    /// teachers/{teacherId} doc when classIds was empty. Because every identity
    /// helper (userRole/userSchoolId/userTeacherId) re-invokes getUserData()
    /// (= a get()), and Firestore caps each request at 1000 expression
    /// evaluations (NOT cached like billed reads), that fallback's extra
    /// getUserData()-derived calls blew past the 1000-expression ceiling for
    /// teachers with empty classIds — which Firestore treats as an error and
    /// DENIES. The correct fix is to keep classIds populated on allowed_users
    /// (addTeacher / updateTeacher stamp it; existing docs were backfilled)
    /// rather than reading the teachers doc from inside the rule.
    /// Membership test against a PRE-FETCHED class-id list. Callers must pass
    /// userClassIds() exactly once: the previous version re-invoked
    /// userClassIds() (→ getUserData() → a get) up to 8 times per check, which
    /// — combined with inSchool()/isManagement()/isAnyTeacher() each also
    /// re-deriving identity — pushed teacher writes past Firestore's
    /// 1000-expression-per-request ceiling, so they were DENIED (management
    /// short-circuited before reaching here, which is why only teachers broke).
    function classIdInList(cls, ids, sec) {
      return cls in ids
          || (cls.split('-')[0] in ids)
          || (('Class ' + cls.split('-')[0]) in ids)
          || (sec != '' && (
                ((cls + '-' + sec) in ids)
             || ((cls + '_' + sec) in ids)
             || (cls.split(' ').size() > 1 && (
                   ((cls.split(' ')[1] + '-' + sec) in ids)
                || ((cls.split(' ')[1] + '_' + sec) in ids)
             ))
          ));
    }

    function isClassTeacher(cls) {
      return classIdInList(
        cls,
        userClassIds(),
        (request.resource != null && 'data' in request.resource && 'section' in request.resource.data)
          ? request.resource.data.section : ''
      );
    }

    /// Recovers the class name from an ATTENDANCE document id and tests it
    /// against the caller's classIds[].
    ///
    /// Attendance doc ids are "<classKey>_<section>_<Y-M-D>" where classKey is
    /// the class name with spaces encoded as underscores (StudentService._todayKey
    /// builds it from "<className> <section>"). e.g. "6-B_B_2026-6-4" or
    /// "Class_6_A_2026-6-4". The class teacher's classIds[] holds the plain class
    /// name ("6-B" or "Class 6"). We therefore reconstruct the leading class
    /// segment(s) and test membership — covering 1-word/hyphenated names and
    /// 2-word names. Pure string ops (no get()), so it stays well under the
    /// 1000-expression ceiling.
    function isAttendanceClassTeacher(cls) {
      return (cls.split('_')[0] in userClassIds()) ||
             (cls.split('_').size() >= 4 &&
                (cls.split('_')[0] + ' ' + cls.split('_')[1]) in userClassIds()) ||
             (cls.split('_').size() >= 4 &&
                (cls.split('_')[0] + '_' + cls.split('_')[1]) in userClassIds());
    }

    /// True when an ATTENDANCE doc id belongs to the guardian's child's class.
    /// Same doc-id reconstruction as [isAttendanceClassTeacher], compared to the
    /// guardian's own studentClass.
    function isGuardianAttendanceClass(cls) {
      return (cls.split('_')[0] == userStudentClass()) ||
             (cls.split('_').size() >= 4 &&
                (cls.split('_')[0] + ' ' + cls.split('_')[1]) == userStudentClass());
    }

    /// True when caller's role is one of the given list literal.
    function hasAnyRole(roles) {
      return userRole() != null && userRole() in roles;
    }

    /// THE permanent system administrator — a single hardcoded email matched
    /// directly against the Firebase Auth token (NOT against any allowed_users
    /// document). This is the unforgeable root of the role hierarchy: it grants
    /// full admin power even when the database is empty (so the admin can
    /// bootstrap the first owner), and no other account can ever obtain it.
    /// Keep this constant in sync with AuthService.rootAdminEmail in the app.
    function isRootAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'mandvishal@gmail.com' ||
        request.auth.token.email.lower() == 'admin@schoolapp.org' ||
        ('isRootAdmin' in request.auth.token && request.auth.token.isRootAdmin == true)
      );
    }

    /// root admin | admin | owner | ownerPrincipal | finance_admin
    function isFinanceAdmin() {
      return isRootAdmin() || hasAnyRole(['admin', 'owner', 'ownerPrincipal', 'finance_admin']);
    }

    // ── Convenience role groups ──────────────────────────────────────────

    // `ownerPrincipal` is the combined owner+principal role created when the
    // owner of a single-school deployment also acts as principal (see
    // main.dart router, login_screen.dart, OwnerPrincipalHome). It MUST
    // appear in every group below or that user is denied across the board
    // after onboarding completes. The hardcoded root admin is folded into every
    // group so it has unconditional access across the system.

    /// root admin | coordinator | principal | admin | owner | ownerPrincipal
    function isManagement() {
      return isRootAdmin() || hasAnyRole(['coordinator', 'principal', 'admin', 'owner', 'ownerPrincipal']);
    }

    /// root admin | admin | owner | ownerPrincipal  (user-lifecycle / privileged ops)
    function isStrictAdmin() {
      return isRootAdmin() || hasAnyRole(['admin', 'owner', 'ownerPrincipal']);
    }

    /// teacher | subjectTeacher
    function isAnyTeacher() {
      return hasAnyRole(['teacher', 'subjectTeacher']);
    }

    /// Any staff member (teachers + management) — plus the root admin.
    function isAnyStaff() {
      return isRootAdmin() || hasAnyRole(['teacher', 'subjectTeacher',
                         'coordinator', 'principal',
                         'admin', 'owner', 'ownerPrincipal']);
    }


    // ════════════════════════════════════════════════════════════════
    // TASKS  (/tasks/{taskId})
    // ════════════════════════════════════════════════════════════════
    // Phase 3 tenancy: `tasks` is a root (cross-school) collection scoped by a
    // `schoolId` field. Reads were previously open to ANY authenticated user of
    // ANY school — a cross-tenant leak of class/student task data (#6). They are
    // now confined to the caller's school; queries must add .where('schoolId').
    match /tasks/{taskId} {
      allow read: if isSignedIn()
        && (isRootAdmin() || resource.data.schoolId == userSchoolId());

      // Staff create/delete in their own school (create must stamp schoolId).
      allow create: if isSignedIn() && isAnyStaff()
        && request.resource.data.schoolId == userSchoolId();
      allow delete: if isSignedIn() && isAnyStaff()
        && (isRootAdmin() || resource.data.schoolId == userSchoolId());

      // Staff may update any field (own school). A guardian may update ONLY the
      // studentStatuses map, AND only the entry for their OWN child — enforced
      // server-side here (previously "scoping to their own child" was a
      // client-only promise, so a guardian could mark/unmark every student).
      // The map key is "{studentClass}_{studentRoll}" (TaskService.updateStudentStatus);
      // we diff the sub-map and require the only changed key to be the
      // guardian's own child key.
      allow update: if isSignedIn()
        && (isRootAdmin() || resource.data.schoolId == userSchoolId())
        && (
          isAnyStaff() ||
          (isRole('guardian')
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['studentStatuses'])
            && request.resource.data.studentStatuses
                 .diff(resource.data.studentStatuses).affectedKeys()
                 .hasOnly([userStudentClass() + '_' + string(userStudentRoll())]))
        );
    }


    // ════════════════════════════════════════════════════════════════
    // PERSONAL TO-DOS  (/personal_todos/{todoId} — ROOT collection)
    //
    // Private per-user task list (TodoService). Each doc carries a `userId`
    // the app sets to the caller's IDENTITY — email for coordinator/principal,
    // teacherId for teachers (with an email fallback). It is NOT the auth UID,
    // so ownership is matched against userEmail() OR userTeacherId().
    //
    // A user may only read/write their own todos. (String == null comparisons
    // return false in rules, so the userTeacherId() branch is safe for callers
    // without a teacherId.)
    // ════════════════════════════════════════════════════════════════
    match /personal_todos/{todoId} {
      allow read, update, delete: if isSignedIn() && (
        (resource.data.userId is string && resource.data.userId.lower() == userEmail()) ||
        resource.data.userId == userTeacherId()
      );

      allow create: if isSignedIn() && (
        (request.resource.data.userId is string && request.resource.data.userId.lower() == userEmail()) ||
        request.resource.data.userId == userTeacherId()
      );
    }


    // ════════════════════════════════════════════════════════════════
    // HOMEWORK  (/homework — ROOT collection, see HomeworkService)
    //
    // The live HomeworkService reads/writes the ROOT `homework` collection
    // (not schools/{sid}/homework). Cross-school by path, acceptable while the
    // app is single-school (same precedent as /tasks). A school-scoped homework
    // rule also exists below for forward-compatibility.
    //
    // Read:   any authenticated member (teachers, management, guardians).
    // Create: teacher (own teacherId, no impersonation) or management.
    // Update/Delete: teacher or management.
    // ════════════════════════════════════════════════════════════════
    // Phase 3 tenancy: homework is a root (cross-school) collection scoped by a
    // schoolId field (Phase 1 writes + Phase 2 backfill). Reads/edits are
    // confined to the caller's school; queries must add .where('schoolId', ...).
    match /homework/{docId} {
      allow read: if isSignedIn()
        && (isRootAdmin() || resource.data.schoolId == userSchoolId());

      allow create: if isSignedIn()
        && (isManagement() || isAnyTeacher())
        && request.resource.data.teacherId == userTeacherId()
        && request.resource.data.schoolId == userSchoolId();

      // A teacher may edit/delete only their OWN homework; management may edit
      // any. Previously any teacher could edit/delete any other teacher's
      // homework in the same school (review #13).
      allow update, delete: if isSignedIn()
        && (isRootAdmin() || resource.data.schoolId == userSchoolId())
        && (isManagement()
            || (isAnyTeacher() && resource.data.teacherId == userTeacherId()));
    }


    // ════════════════════════════════════════════════════════════════
    // COPY CHECKS  (/copy_checks — ROOT collection, see CopyCheckService)
    //
    // Live CopyCheckService uses the ROOT `copy_checks` collection (+ a
    // `statuses` subcollection). Staff-only — contains per-student PII, no
    // guardian use-case.
    // ════════════════════════════════════════════════════════════════
    // Phase 3 tenancy: copy_checks reads are confined to the caller's school
    // (schoolId stamped Phase 1 + backfilled). Queries must add
    // .where('schoolId', ...). The statuses subcollection has no schoolId of its
    // own but is only reachable via a parent check the caller can already read.
    match /copy_checks/{checkId} {
      allow read:  if isSignedIn() && isAnyStaff()
        && (isRootAdmin() || resource.data.schoolId == userSchoolId());

      // Writes are tenant-scoped (review #7): the old `allow write` had NO
      // schoolId check, so any teacher of ANY school could create/overwrite/
      // delete any copy-check doc in this root collection. Create requires the
      // new doc to carry the caller's schoolId; update/delete require the
      // existing doc to belong to the caller's school.
      allow create: if isSignedIn() && (isManagement() || isAnyTeacher())
        && request.resource.data.schoolId == userSchoolId();
      allow update, delete: if isSignedIn() && (isManagement() || isAnyTeacher())
        && (isRootAdmin() || resource.data.schoolId == userSchoolId());

      // Phase 3 tenancy: statuses inherit the parent copy_check's schoolId.
      // The parent read rule already gates on schoolId, and statuses are only
      // reachable through a parent the caller can read. Explicit school check
      // added here to block collection-group query bypass.
      match /statuses/{statusId} {
        allow read:  if isSignedIn() && isAnyStaff()
          && (isRootAdmin() || get(/databases/$(database)/documents/copy_checks/$(checkId)).data.schoolId == userSchoolId());
        allow write: if isSignedIn() && (isManagement() || isAnyTeacher())
          && (isRootAdmin() || get(/databases/$(database)/documents/copy_checks/$(checkId)).data.schoolId == userSchoolId());
      }
    }
    // NOTE: Duplicate flat fee_payments rule removed (Phase 2 audit).
    // The canonical fee_payments rules are the hierarchical ones at
    // /schools/{sid}/fee_payments/{classId}/students/{roll}/payments/{id}
    // defined below (around line 1017). The duplicate here used a flat
    // /schools/{sid}/fee_payments/{paymentId} pattern with resource.data.schoolId
    // checks, which conflicted with the hierarchical structure and could match
    // unintended paths.


    // ════════════════════════════════════════════════════════════════
    // SYSTEM CONFIGURATION  (/system/{document})
    // ════════════════════════════════════════════════════════════════
    match /system/{document} {
      allow read, write: if isRootAdmin();
    }


    // ════════════════════════════════════════════════════════════════
    // ALLOWED USERS  (/allowed_users/{uid})
    //
    // Root collection — identity is cross-school by design. schoolId
    // embedded in each document scopes reads and writes.
    // ════════════════════════════════════════════════════════════════
    match /allowed_users/{email} {

      // Own document, OR any coordinator / principal / admin in the same school.
      allow read: if isRootAdmin() || (isSignedIn() && (
        userEmail() == email ||
        (isManagement() && 'schoolId' in resource.data && userSchoolId() == resource.data.schoolId)
      ));

      // Client-side writes are allowed for self-updates (e.g., status/school switching) and school management.
      // All other mutations must call secure Cloud Functions.
      allow create: if isRootAdmin() || (isSignedIn() && (
        // Management can provision users in their own school
        (isStrictAdmin() &&
         request.resource.data.schoolId == userSchoolId() &&
         request.resource.data.role in ['principal', 'coordinator', 'teacher', 'subjectTeacher', 'guardian']) ||
        
        (isRole('principal') &&
         request.resource.data.schoolId == userSchoolId() &&
         request.resource.data.role in ['coordinator', 'teacher', 'subjectTeacher', 'guardian']) ||

        (isRole('coordinator') &&
         request.resource.data.schoolId == userSchoolId() &&
         request.resource.data.role in ['teacher', 'subjectTeacher', 'guardian'])
      ));

      allow update: if isRootAdmin() || (isSignedIn() && (
        // Self update: status can transition to 'active', schoolId can switch (other fields require Cloud Functions)
        (userEmail() == email &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schoolId', 'status']) &&
         (request.resource.data.schoolId == resource.data.schoolId || 
          ('schoolIds' in resource.data && request.resource.data.schoolId in resource.data.schoolIds))) ||
        
        // Management updates in same school (excluding role changes)
        (isStrictAdmin() &&
         resource.data.schoolId == userSchoolId() &&
         request.resource.data.schoolId == userSchoolId() &&
         request.resource.data.role == resource.data.role) ||
        
        (isRole('principal') &&
         resource.data.schoolId == userSchoolId() &&
         request.resource.data.schoolId == userSchoolId() &&
         resource.data.role in ['coordinator', 'teacher', 'subjectTeacher', 'guardian'] &&
         request.resource.data.role == resource.data.role) ||

        (isRole('coordinator') &&
         resource.data.schoolId == userSchoolId() &&
         request.resource.data.schoolId == userSchoolId() &&
         resource.data.role in ['teacher', 'subjectTeacher', 'guardian'] &&
         request.resource.data.role == resource.data.role)
      ));

      allow delete: if isRootAdmin() || (isSignedIn() && (
        // Management delete in same school (with strict rank checking)
        (isStrictAdmin() && resource.data.schoolId == userSchoolId() && !(resource.data.role in ['admin', 'owner', 'ownerPrincipal'])) ||
        (isRole('principal') && resource.data.schoolId == userSchoolId() && resource.data.role in ['coordinator', 'teacher', 'subjectTeacher', 'guardian']) ||
        (isRole('coordinator') && resource.data.schoolId == userSchoolId() && resource.data.role in ['teacher', 'subjectTeacher', 'guardian'])
      ));
    }


    // ════════════════════════════════════════════════════════════════
    // SCHOOL ROOT DOCUMENT  (/schools/{sid})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid} {
      allow read:  if isRootAdmin() || (isSignedIn() && inSchool(sid));
      allow write: if isRootAdmin() || (isSignedIn() && inSchool(sid) && isStrictAdmin());
    }


    // ════════════════════════════════════════════════════════════════
    // CLASSES  (/schools/{sid}/classes/{classId})
    //
    // Per-class container created by SchoolSettingsService during school
    // onboarding (Complete Setup), and by the on-the-fly class creator.
    // Document body is metadata only ({classId, createdAt}).
    //
    // Subcollections under this path (used by FirestoreService):
    //   /attendance      – class-day attendance docs
    //   /studentProfiles – per-roll profile blobs
    //   /tests           – per-class tests
    //
    // Reads: any school member (teachers, guardians need basic class info).
    // Writes: management for the class doc itself (onboarding, edits) AND
    //         any staff member for the subcollections (teachers writing
    //         attendance, profiles, tests for their classes).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/classes/{classId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();

      // Subcollections (attendance, studentProfiles, tests). Recursive {sub=**}
      // covers any depth below /classes/{classId}/. Staff-only — guardians
      // get their child-scoped views via the existing top-level rules
      // (/schools/{sid}/attendance/{cls} etc.).
        match /{sub=**} {
          allow read: if isSignedIn() && inSchool(sid) && isAnyStaff();
          // Write: management or class teacher for attendance docs
          allow write: if isSignedIn() && inSchool(sid) && (isManagement() || (isAnyTeacher() && isAttendanceClassTeacher(request.resource.id)));
        }

      // Explicit PTM events nested under class (so guardians can read class PTM info)
      match /ptm/{ptmId} {
        allow read: if isSignedIn() && inSchool(sid) && (
          isAnyStaff() ||
          (isRole('guardian') && (
             classId == replaceSpaces(userStudentClass()) ||
             ('classIds' in getUserData() && classId in getUserData().classIds)
          ))
        );
        allow write: if isSignedIn() && inSchool(sid) && (
          isManagement() ||
          (isAnyTeacher() && classId in userClassIds())
        );
      }
    }


    // ════════════════════════════════════════════════════════════════
    // STUDENTS  (/schools/{sid}/students/{studentId})
    //
    // Document ID = "{className}_{section}_{roll}" (spaces → underscores)
    // Guardian access is gated on studentId appearing in their studentIds[].
    // Guardian may self-serve guardianDetails for their own child.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/students/{studentId} {

      allow read: if isSignedIn() && ((isAnyStaff() && inSchool(sid)) || (
        inSchool(sid) && isRole('guardian')
        && 'guardianEmail' in resource.data
        && resource.data.guardianEmail.lower() == request.auth.token.email.lower()
      ));

      allow create: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(request.resource.data.className))
      );

      // Guardian branch FIRST so a guardian short-circuits before the heavier
      // isManagement()/isAnyTeacher()/isClassTeacher() chain — keeps this rule
      // under Firestore's 1000-expression-per-request ceiling.
      allow update: if isSignedIn() && inSchool(sid) && (
        // Guardian: only guardianDetails / guardianEmail, for their OWN child.
        (isRole('guardian')
          && 'guardianEmail' in resource.data
          && resource.data.guardianEmail.lower() == request.auth.token.email.lower()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['guardianDetails', 'guardianEmail'])) ||
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(resource.data.className))
      );

      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // STUDENT REMARKS  (/schools/{sid}/students/{studentId}/remarks/{rid})
    //
    // Read:   any staff OR the student's own guardian.
    // Create: any staff OR the student's own guardian (for school feedback).
    // Update/Delete: management OR the original author of the remark.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/students/{studentId}/remarks/{remarkId} {
      allow read, create: if isSignedIn() && (
        (isAnyStaff() && inSchool(sid)) ||
        // Own child — studentId is "{class}_{section}_{roll}". Remark docs carry
        // no className/roll fields, so match the parent doc ID instead.
        (inSchool(sid) && isRole('guardian') && (
           studentId == guardianStudentId() ||
           ('studentIds' in getUserData() && studentId in getUserData().studentIds)
        ))
      );

      allow update, delete: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (resource.data != null && 'createdBy' in resource.data && resource.data.createdBy.lower() == userEmail())
      );
    }


    // ════════════════════════════════════════════════════════════════
    // CONSENTS  (/schools/{sid}/students/{studentId}/consents/{consentId})
    //
    // Parental-consent records (ConsentService). Previously had NO rule, so
    // every read/write was default-denied and the entire consent feature was
    // dead. Scoped like remarks: staff, or the student's own guardian.
    //   Read/Create/Update: any staff OR the child's guardian.
    //   Delete: management only (consents are part of the compliance record).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/students/{studentId}/consents/{consentId} {
      allow read, create, update: if isSignedIn() && (
        (isAnyStaff() && inSchool(sid)) ||
        (inSchool(sid) && isRole('guardian') && (
           studentId == guardianStudentId() ||
           ('studentIds' in getUserData() && studentId in getUserData().studentIds)
        ))
      );
      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // PROVIDED DETAILS  (detail-correction workflows under a student)
    //   /schools/{sid}/students/{studentId}/guardianProvidedDetails/{id}
    //   /schools/{sid}/students/{studentId}/schoolProvidedDetails/{id}
    //
    // Used by StudentService.submit*ProvidedDetails / watch* / update*Status.
    // These had NO rule, so every read/write was default-denied and the whole
    // detail-sync workflow silently failed (review finding). Scoped like
    // consents/remarks.
    //   guardianProvidedDetails: guardian raises a correction; staff resolves.
    //   schoolProvidedDetails:   school authors; guardian acknowledges/reads.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/students/{studentId}/guardianProvidedDetails/{detailId} {
      allow read: if isSignedIn() && (
        (isAnyStaff() && inSchool(sid)) ||
        (inSchool(sid) && isRole('guardian') && (
           studentId == guardianStudentId() ||
           ('studentIds' in getUserData() && studentId in getUserData().studentIds)
        ))
      );
      allow create: if isSignedIn() && inSchool(sid)
        && isRole('guardian') && (
           studentId == guardianStudentId() ||
           ('studentIds' in getUserData() && studentId in getUserData().studentIds)
        );
      allow update: if isSignedIn() && inSchool(sid) && isManagement();
      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }

    match /schools/{sid}/students/{studentId}/schoolProvidedDetails/{detailId} {
      allow read: if isSignedIn() && (
        (isAnyStaff() && inSchool(sid)) ||
        (inSchool(sid) && isRole('guardian') && (
           studentId == guardianStudentId() ||
           ('studentIds' in getUserData() && studentId in getUserData().studentIds)
        ))
      );
      allow create, update: if isSignedIn() && inSchool(sid)
        && (isManagement() || isAnyTeacher());
      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // CONSENT WITHDRAWALS  (/schools/{sid}/consent_withdrawals/{wfId})
    //
    // Workflow documents created when a guardian withdraws consent.
    // Read/update: management only (admin must review and action).
    // Create: any authenticated school member (guardian + service layer).
    // Delete: nobody.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/consent_withdrawals/{wfId} {
      allow read, update: if isSignedIn() && inSchool(sid) && isManagement();
      // A withdrawal is the guardian's own action (or recorded by management);
      // a teacher may no longer file one on a guardian's behalf (review #37).
      allow create:       if isSignedIn() && inSchool(sid)
                            && (isManagement() || isRole('guardian'));
      allow delete:       if false;
    }


    // ════════════════════════════════════════════════════════════════
    // TEACHERS  (/schools/{sid}/teachers/{teacherId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/teachers/{teacherId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // TEACHER DELETION REQUESTS
    // (/schools/{sid}/teacher_deletion_requests/{requestId})
    //
    // Workflow: a coordinator cannot directly remove a teacher; they file
    // a request here that a principal or owner must approve before the
    // actual delete runs. Mirrors the student_deletion_requests pattern.
    //
    // Read:    any management member (coordinator sees their own + the
    //          list; principal/owner sees everything in their school).
    // Create:  coordinator in their own school. status MUST be 'pending'
    //          and requestedBy MUST equal the caller's email — no
    //          impersonation, no self-approving.
    // Update:  principal/admin/owner — to approve or reject (status +
    //          reviewer fields only) OR the original requesting
    //          coordinator — to cancel their own pending request
    //          (status only, set to 'cancelled').
    // Delete:  admin/owner only (archival/cleanup).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/teacher_deletion_requests/{requestId} {

      allow read: if isSignedIn() && inSchool(sid) && isManagement();

      allow create: if isSignedIn() && inSchool(sid)
        && isRole('coordinator')
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == userEmail();

      allow update: if isSignedIn() && inSchool(sid) && (

        // Principal / admin / owner: approve or reject. May only touch
        // status + reviewer-stamp fields.
        (hasAnyRole(['principal', 'admin', 'owner', 'ownerPrincipal'])
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedBy', 'reviewedByRole',
                         'reviewedByName', 'reviewedAt', 'rejectionNote'])) ||

        // Original requester: cancel their own pending request.
        (isRole('coordinator')
          && resource.data.requestedBy == userEmail()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'cancelledAt']))
      );

      allow delete: if isSignedIn() && inSchool(sid) && isStrictAdmin();
    }


    // ════════════════════════════════════════════════════════════════
    // STUDENT DELETION REQUESTS
    // (/schools/{sid}/student_deletion_requests/{requestId})
    //
    // Workflow: a class teacher files a request; only the PRINCIPAL (or
    // admin/owner) reviews and approves/rejects it. Coordinators are NOT
    // involved — the review screen lives solely on the principal dashboard,
    // so coordinators are excluded at the data layer too (no read/update/
    // delete), even though they are "management" elsewhere.
    //
    // Read/Update/Delete: principal | admin | owner | ownerPrincipal.
    // Create: any teacher or management member; status must be 'pending'.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/student_deletion_requests/{requestId} {
      allow read, update, delete: if isSignedIn() && inSchool(sid)
        && hasAnyRole(['principal', 'admin', 'owner', 'ownerPrincipal']);
      // Management may file for anyone; a teacher may file only under their OWN
      // identity (no impersonation — teacherEmail must equal the caller).
      allow create: if isSignedIn() && inSchool(sid)
        && request.resource.data.status == 'pending'
        && (
          isManagement() ||
          (isAnyTeacher()
            && 'teacherEmail' in request.resource.data
            && request.resource.data.teacherEmail.lower() == userEmail())
        );
    }


    // ════════════════════════════════════════════════════════════════
    // DELETED STUDENTS  (/schools/{sid}/deleted_students/{tombstoneId})
    //
    // Read-only history of permanently-removed students, surfaced in the
    // "Deleted Students" section of the class-teacher, coordinator and
    // principal dashboards. Unlike student_deletion_requests (principal-only),
    // these tombstones are readable by ANY staff member; the class-teacher view
    // scopes to its own class client-side.
    //
    // Read:   any staff (mirrors the students collection read rule).
    // Create: written by the principal-approved deletion flow → management.
    // Delete: management (housekeeping). No updates — records are immutable.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/deleted_students/{tombstoneId} {
      allow read:   if isSignedIn() && inSchool(sid) && isAnyStaff();
      allow create: if isSignedIn() && inSchool(sid) && isManagement();
      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }

    // ════════════════════════════════════════════════════════════════
    // ADMISSION LEADS / ENQUIRIES  (/schools/{sid}/leads/{leadId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/leads/{leadId} {
      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        isAnyTeacher() ||
        (isRole('guardian') && 'createdByEmail' in resource.data && resource.data.createdByEmail.lower() == userEmail())
      );
      
      allow create: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        isAnyTeacher() ||
        (isRole('guardian') && 'createdByEmail' in request.resource.data && request.resource.data.createdByEmail.lower() == userEmail())
      );
      
      allow update: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        isAnyTeacher() ||
        (isRole('guardian') && 'createdByEmail' in resource.data && resource.data.createdByEmail.lower() == userEmail()
                            && 'createdByEmail' in request.resource.data && request.resource.data.createdByEmail.lower() == userEmail())
      );
      
      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // ATTENDANCE  (/schools/{sid}/attendance/{cls})
    //
    // Document ID = "<classKey>_<section>_<Y-M-D>" (spaces → underscores),
    // e.g. "6-B_B_2026-6-4" — NOT the bare class name. The class name is the
    // leading segment(s); see isAttendanceClassTeacher / isGuardianAttendanceClass.
    // Guardian: restricted to their child's class. Write: that class's teacher,
    // or management.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/attendance/{cls} {

      // STAFF-ONLY (H2). The class-day doc holds EVERY student's status, call
      // reasons, and called-flags in one document — Firestore rules cannot
      // field-filter, so granting a guardian read here exposed every classmate's
      // attendance to any parent in the class. Guardians now read ONLY their own
      // child via the per-student mirror below (`student_attendance/{id}`), which
      // the onAttendanceWritten Cloud Function keeps in sync.
      allow read: if isSignedIn() && inSchool(sid) && isAnyStaff();

      allow write: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isAttendanceClassTeacher(cls) &&
         request.resource.data.date != null &&
         request.resource.data.date is timestamp &&
         request.time - request.resource.data.date < duration.value(7, 'd'))
      );
    }


    // ════════════════════════════════════════════════════════════════
    // DASHBOARD ROLLUPS  (SCALE-02)
    //
    // attendance_summary/{docId}: per-section-day projection of the class-day
    // attendance doc — counts + the absent/leave detail list (names/phones).
    // Same PII surface as the class attendance doc above, so STAFF-ONLY read.
    // class_stats/{key}: per-class visible-enrollment counter (just a total).
    //
    // BOTH are authored SERVER-SIDE only (onAttendanceWritten / syncClassStats /
    // backfill callables via the Admin SDK, which bypasses these rules), so all
    // client writes are denied. `allow write: if false` does not block the
    // trigger/backfill.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/attendance_summary/{summaryId} {
      allow read:  if isSignedIn() && inSchool(sid) && isAnyStaff();
      allow write: if false;
    }

    match /schools/{sid}/class_stats/{classKey} {
      allow read:  if isSignedIn() && inSchool(sid) && isAnyStaff();
      allow write: if false;
    }


    // ════════════════════════════════════════════════════════════════
    // PER-STUDENT ATTENDANCE MIRROR  (/schools/{sid}/student_attendance/{studentId})
    //
    // H2: a single-student projection of attendance — year-partitioned as
    // { days_{YYYY}: {dateKey: status} } (SCALE-13, was a flat `days` map) —
    // written SERVER-SIDE by the onAttendanceWritten Cloud Function (Admin SDK,
    // which bypasses these rules) and seeded by the backfillStudentAttendance
    // callable. It exists so a guardian can read their OWN child's attendance
    // without reading the class-day doc that holds every classmate's status.
    //
    // Read:  any staff in the school, OR the student's own guardian (doc id ==
    //        guardianStudentId()).
    // Write: denied to ALL clients — authored only via the Admin SDK, which is
    //        not subject to these rules. (`allow write: if false` does not block
    //        the trigger/backfill.)
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/student_attendance/{studentId} {
      // Single-get() helper (canReadStudentAttendance) keeps this under the
      // 1000-expression ceiling — see canReadExamResult for the same pattern.
      allow read: if isSignedIn() && canReadStudentAttendance(sid, studentId);
      allow write: if false;
    }


    // ════════════════════════════════════════════════════════════════
    // ANNOUNCEMENTS  (/schools/{sid}/announcements/{id})
    //
    // Read:   any school member.
    // Create: management posts to any audience. A teacher may post ONLY to a
    //         class they teach — audience must be 'class:{cls}' with cls in
    //         their classIds[] — and may not pose as another user (postedBy ==
    //         their own email).
    // Update/Delete: management moderates anything; a teacher may edit/delete
    //         only their OWN posts (postedBy == their email). The teacher edit
    //         flow deletes-then-recreates, so both verbs are needed.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/announcements/{announcementId} {
      allow read: if isSignedIn() && inSchool(sid);

      allow create: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher()
          && request.resource.data.audience is string
          && request.resource.data.audience.split(':')[0] == 'class'
          && request.resource.data.audience.split(':')[1] in userClassIds()
          && request.resource.data.postedBy.lower() == userEmail())
      );

      allow update, delete: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && resource.data.postedBy.lower() == userEmail())
      );
    }


    // ════════════════════════════════════════════════════════════════
    // LEAVE APPLICATIONS  (/schools/{sid}/leave_applications/{leaveId})
    //
    // Read:   submitting teacher (teacherId == uid) + management.
    // Create: any teacher; teacherId MUST equal their own uid.
    // Update: management → status/review fields only.
    //         Teacher (own pending application) → everything except status.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/leave_applications/{leaveId} {

      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && 'teacherId' in resource.data && resource.data.teacherId == userTeacherId()) ||
        (isRole('guardian')
          && 'applicantType' in resource.data && resource.data.applicantType == 'guardian'
          && 'studentClass' in resource.data && resource.data.studentClass == userStudentClass()
          && 'studentRoll' in resource.data && resource.data.studentRoll == userStudentRoll()
          && 'studentSection' in resource.data && resource.data.studentSection == userStudentSection()) ||
        (isAnyTeacher() && 'studentClass' in resource.data && (resource.data.studentClass in userClassIds() || isClassTeacher(resource.data.studentClass)))
      );

      // No impersonation: teacherId must equal the calling user's teacherId, or guardian matches student info.
      allow create: if isSignedIn() && inSchool(sid) && (
        (isAnyTeacher()
          && 'teacherId' in request.resource.data
          && request.resource.data.teacherId == userTeacherId()
          && 'teacherEmail' in request.resource.data
          && request.resource.data.teacherEmail.lower() == userEmail()) ||
        (isRole('guardian')
          && 'applicantType' in request.resource.data && request.resource.data.applicantType == 'guardian'
          && 'studentClass' in request.resource.data && request.resource.data.studentClass == userStudentClass()
          && 'studentRoll' in request.resource.data && request.resource.data.studentRoll == userStudentRoll()
          && 'studentSection' in request.resource.data && request.resource.data.studentSection == userStudentSection())
      );

      allow update: if isSignedIn() && inSchool(sid) && (

        // Management may only update status + review metadata + coordinatorNote.
        (isManagement()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'remarks', 'coordinatorNote'])) ||

        // Submitting teacher may edit body fields of their own PENDING leave
        // but may NOT touch status or reassign teacherId.
        (isAnyTeacher()
          && 'teacherId' in resource.data
          && resource.data.teacherId == userTeacherId()
          && resource.data.status == 'pending'
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['status', 'teacherId'])) ||

        // Class teacher may update status/coordinatorNote of guardian-submitted student leaves
        (isAnyTeacher()
          && 'studentClass' in resource.data
          && 'applicantType' in resource.data && resource.data.applicantType == 'guardian'
          && isClassTeacher(resource.data.studentClass)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'coordinatorNote']))
      );

      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // EMAIL CHANGE REQUESTS  (/schools/{sid}/email_change_requests/{reqId})
    //
    // Read:   submitting guardian + management.
    // Create: any guardian; currentEmail MUST equal the caller's email.
    // Update/Delete: management.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/email_change_requests/{reqId} {
      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isRole('guardian')
          && 'currentEmail' in resource.data
          && resource.data.currentEmail.lower() == userEmail())
      );

      allow create: if isSignedIn() && inSchool(sid)
        && isRole('guardian')
        && 'currentEmail' in request.resource.data
        && request.resource.data.currentEmail.lower() == userEmail()
        && 'newEmail' in request.resource.data
        && request.resource.data.newEmail is string
        && request.resource.data.newEmail.size() < 100
        && 'status' in request.resource.data
        && request.resource.data.status == 'pending';

      allow update, delete: if isSignedIn() && inSchool(sid) && isManagement();
    }

    // ════════════════════════════════════════════════════════════════
    // ACCOUNT DELETION REQUESTS (/schools/{sid}/account_deletion_requests/{reqId})
    //
    // Google Play requires that signed-in users can INITIATE deletion of
    // their account from inside the app. Accounts here are provisioned by
    // the school (the data controller), so self-serve hard-delete is not
    // appropriate; instead any signed-in member files a request that school
    // management processes via the existing deleteAccount cascade (A4).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/account_deletion_requests/{reqId} {
      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        ('email' in resource.data && resource.data.email.lower() == userEmail())
      );

      // Any signed-in member of the school may request deletion of THEIR OWN
      // account only — the email must match the caller's token.
      allow create: if isSignedIn() && inSchool(sid)
        && 'email' in request.resource.data
        && request.resource.data.email.lower() == userEmail()
        && 'status' in request.resource.data
        && request.resource.data.status == 'pending'
        && (!('reason' in request.resource.data)
            || (request.resource.data.reason is string
                && request.resource.data.reason.size() < 500));

      allow update, delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // FEE STRUCTURES  (/schools/{sid}/fee_structures/{classId})
    //
    // Class-level FeeStructure documents.
    // Guardian reads limited to their children's class (via classIds[]).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/fee_structures/{classId} {

      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        // Guardian reads the fee structure for their child's class only.
        (isRole('guardian') && (
          resource == null ||
          resource.data.className == userStudentClass() ||
          ('classIds' in getUserData() && (
             resource.data.className in getUserData().classIds ||
             replaceSpaces(resource.data.className) in getUserData().classIds
          ))
        ))
      );

      allow write: if isSignedIn() && inSchool(sid) && isFinanceAdmin();
    }


    // ════════════════════════════════════════════════════════════════
    // FEE PAYMENTS  (/schools/{sid}/fee_payments/{classId})
    //
    // Hierarchical: fee_payments/{classId}/students/{roll}/payments/{id}
    // Guardian reads limited to their own children (via studentIds[]).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/fee_payments/{classId} {

      // {classId} is the underscored class name (e.g. "Class_9-A").
      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isRole('guardian') && (
           classId == replaceSpaces(userStudentClass()) ||
           ('classIds' in getUserData() && (
              classId in getUserData().classIds ||
              classId + '-A' in getUserData().classIds ||
              classId + '-B' in getUserData().classIds ||
              classId + '-C' in getUserData().classIds ||
              classId + '-D' in getUserData().classIds ||
              classId + '-E' in getUserData().classIds
           ))
        ))
      );

      allow write: if isSignedIn() && inSchool(sid) && isFinanceAdmin();

      // Intermediate student node — lets management LIST the students that have
      // payments under a class (PrincipalDigestService fans out across
      // fee_payments/{classId}/students/* to total today's collection). Without
      // this the list query is denied: the payments rule below only covers the
      // payment leaf docs, not the students collection that contains them.
      match /students/{roll} {
        allow read: if isSignedIn() && inSchool(sid) && (
          isManagement() ||
          (isRole('guardian') && (
             (classId == replaceSpaces(userStudentClass()) && roll == string(userStudentRoll())) ||
             ('studentIds' in getUserData() && (
                classId + '_' + roll in getUserData().studentIds ||
                classId + '_A_' + roll in getUserData().studentIds ||
                classId + '_B_' + roll in getUserData().studentIds ||
                classId + '_C_' + roll in getUserData().studentIds ||
                classId + '_D_' + roll in getUserData().studentIds ||
                classId + '_E_' + roll in getUserData().studentIds
             ))
          ))
        );
        allow write: if isSignedIn() && inSchool(sid) && isFinanceAdmin();
      }

      // (fee_meta counter rule is defined as a sibling match below.)
    }

    // ════════════════════════════════════════════════════════════════
    // FLAT PAYMENTS  (/schools/{sid}/payments/{paymentId})
    //
    // Holds individual payment transactions for students in the school.
    // Guardian reads limited to their own child's payments.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/payments/{paymentId} {
      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isRole('guardian') && (
           ('studentId' in resource.data && 'studentIds' in getUserData() && resource.data.studentId in getUserData().studentIds) ||
           (resource.data.className == userStudentClass() && resource.data.roll == userStudentRoll()) ||
           ('studentIds' in getUserData() && (
              (replaceSpaces(resource.data.className) + '_' + string(resource.data.roll) in getUserData().studentIds) ||
              (replaceSpaces(resource.data.className) + '_' + replaceSpaces(resource.data.section) + '_' + string(resource.data.roll) in getUserData().studentIds)
           ))
        ))
      );
      allow write: if isSignedIn() && inSchool(sid) && isFinanceAdmin();
    }


    // CLASS FEE SUMMARIES  (/schools/{sid}/class_fee_summaries/{classKey})
    //
    // Holds pre-aggregated class-wide fee metrics. Read-only for management.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/class_fee_summaries/{classKey} {
      allow read: if isSignedIn() && inSchool(sid) && isManagement();
      allow write: if false;
    }

    // SCHOOL SUMMARIES  (/schools/{sid}/summaries/{summaryId})
    //
    // Holds school-wide dashboard rollups (e.g. summaries/fees). Read-only for management.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/summaries/{summaryId} {
      allow read: if isSignedIn() && inSchool(sid) && isManagement();
      allow write: if false;
    }


    // ════════════════════════════════════════════════════════════════
    // FEE META  (/schools/{sid}/fee_meta/{docId})
    //
    // Atomic counters (e.g. the gapless receipt-number sequence allocated in
    // FeeService.addPayment). Management only.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/fee_meta/{docId} {
      allow read, write: if isSignedIn() && inSchool(sid) && isFinanceAdmin();
    }


    // ════════════════════════════════════════════════════════════════
    // EXAMS  (/schools/{sid}/exams/{examId})
    //
    // Exam definitions (schedule, maxMarks, className) — no student PII.
    // Readable by every school member including guardians (they see the
    // exam schedule for their child's class). Write: class teacher or mgmt.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/exams/{examId} {
      allow read: if isSignedIn() && inSchool(sid);

      allow create: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(request.resource.data.className))
      );

      allow update: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(resource.data.className))
      );

      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // EXAM RESULTS  (/schools/{sid}/exam_results/{examId})
    //
    // Per-student marks — PERSONAL DATA (roll, studentName, marks).
    // Hierarchical: exam_results/{examId}/students/{roll}
    //
    // Staff (teachers + management) may read all results in their school.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/exam_results/{examId} {

      allow read: if isSignedIn() && inSchool(sid) && isAnyStaff();

      allow write: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(request.resource.data.className))
      );

      match /students/{roll} {
        allow read: if isSignedIn() && canReadExamResult(sid, roll, resource != null && 'studentId' in resource.data ? resource.data.studentId : null);

        allow write: if isSignedIn() && inSchool(sid) && (
          isManagement() ||
          (isAnyTeacher() && isClassTeacher(request.resource.data.className))
        );
      }
    }


    // ════════════════════════════════════════════════════════════════
    // COPY CHECKS  (/schools/{sid}/copy_checks/{checkId})
    //
    // Parent doc: teacher/session metadata (className, subject, teacherId).
    // No student PII — but guardians have no use-case for this data and
    // the statuses subcollection contains per-student PII. Restrict all
    // reads to staff only.
    //
    // Statuses subcollection (/statuses/{rollId}):
    //   Per-student data (roll, studentName, guardianPhone, status).
    //   Staff read/write only — no guardian access.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/copy_checks/{checkId} {

      // Staff-only read: copy-checking is a teacher/management workflow.
      allow read: if isSignedIn() && inSchool(sid) && isAnyStaff();

      allow create: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(request.resource.data.className))
      );

      allow update: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(resource.data.className))
      );

      allow delete: if isSignedIn() && inSchool(sid) && isManagement();

      // Per-student statuses — staff only, no guardian access.
      match /statuses/{rollId} {
        allow read:  if isSignedIn() && inSchool(sid) && isAnyStaff();
        allow write: if isSignedIn() && inSchool(sid) && isAnyStaff();
      }
    }


    // ════════════════════════════════════════════════════════════════
    // STAFF TASKS  (/schools/{sid}/staff_tasks/{taskId})
    //
    // Read:   assignee OR management.
    // Create/Delete: principal | admin | owner only.
    // Update: principal/admin/owner (full) or assignee (status fields only).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/staff_tasks/{taskId} {

      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        userTeacherId() == resource.data.assignedTo
      );

      // ownerPrincipal (combined owner+principal) must be included or that role
      // cannot create/manage staff tasks at all (review #115).
      allow create, delete: if isSignedIn() && inSchool(sid)
        && hasAnyRole(['principal', 'admin', 'owner', 'ownerPrincipal']);

      allow update: if isSignedIn() && inSchool(sid) && (
        hasAnyRole(['principal', 'admin', 'owner', 'ownerPrincipal']) ||

        // Assignee may only update status and completion timestamps.
        (userTeacherId() == resource.data.assignedTo
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt', 'completedAt', 'checkpoints']))
      );
    }


    // ════════════════════════════════════════════════════════════════
    // STAFF REMARKS  (/schools/{sid}/staff_remarks/{remarkId})
    //
    // Feedback notes given by management to staff:
    //   • coordinator → teacher
    //   • principal/owner → teacher | coordinator
    //
    // Read:   the giver, the recipient (teacher by teacherId, coordinator by
    //         email), or top management (principal/admin/owner).
    // Create: principal/admin/owner (any recipient) OR coordinator (teachers
    //         only). The creator must stamp themselves as fromEmail.
    // Delete: the giver, or top management.
    // Update: not allowed (remarks are immutable once sent).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/staff_remarks/{remarkId} {

      allow read: if isSignedIn() && inSchool(sid) && (
        hasAnyRole(['principal', 'admin', 'owner', 'ownerPrincipal']) ||
        userEmail() == resource.data.fromEmail ||
        userEmail() == resource.data.toEmail ||
        (userTeacherId() != null
          && userTeacherId() == resource.data.toTeacherId)
      );

      allow create: if isSignedIn() && inSchool(sid)
        && request.resource.data.fromEmail == userEmail()
        && (
          hasAnyRole(['principal', 'admin', 'owner', 'ownerPrincipal']) ||
          (isRole('coordinator') && request.resource.data.toRole == 'teacher')
        );

      allow delete: if isSignedIn() && inSchool(sid) && (
        hasAnyRole(['principal', 'admin', 'owner', 'ownerPrincipal']) ||
        userEmail() == resource.data.fromEmail
      );
    }


    // ════════════════════════════════════════════════════════════════
    // NOTIFICATIONS  (/schools/{sid}/notifications/{notifId})
    //
    // Audience field formats written by NotificationService:
    //   'all'                     → any authenticated school member
    //   'teachers'                → teacher | subjectTeacher
    //   'guardians'               → any guardian
    //   'coordinator'             → coordinator role
    //   'principal'               → principal role
    //   'teacher:{uid}'           → a specific teacher (UID match)
    //   'class:{class}'           → class-wide notice (class teacher → guardians
    //                               of that class; also visible to staff)
    //   'guardian:{class}:{roll}' → student-specific guardian notification
    //   'class_teacher:{class}'   → the class teacher of the named class
    //
    // Guardian-specific notifications ('guardian:{class}:{roll}'):
    //   The rule enforces student-level access via a `targetStudentId` field
    //   that MUST be written by NotificationService onto each guardian-targeted
    //   document. Format: "{className spaces→underscores}_{section}_{roll}",
    //   e.g. "Class_9-A_A_42" — identical to allowed_users.studentIds[] format.
    //   Notifications that lack this field are DENIED to guardians (no fallback
    //   to class-only check). This prevents a guardian reading another parent's
    //   notification in the same class.
    //
    //   Required app-side change: NotificationService must set
    //     targetStudentId: studentId  when audience = 'guardian:{class}:{roll}'
    //
    // split(':')[1] is safe because class names in this app do not contain
    // colon characters.
    //
    // Write: any authenticated school member for now.
    // TODO: lock down to Cloud Function / Admin SDK service account.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/notifications/{notifId} {

      allow read: if isSignedIn() && canReadNotification(sid, resource.data.audience);

      // Create: management may post to ANY audience. Other school members
      // (teachers, guardians) may only post TARGETED notices — never the
      // broadcast group audiences 'all' / 'teachers' / 'guardians', which were
      // the phishing/spam vector flagged in review (a guardian broadcasting to
      // the whole school, or impersonating the principal to all parents).
      // Targeted flows that must keep working: absent alerts ('guardian:..'),
      // leave-submitted to 'coordinator'/'principal', student-leave to
      // 'class_teacher:..', resolved-leave to 'teacher:..'.
      allow create: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        // Teachers: targeted audiences ONLY, and class/guardian audiences must
        // be for a class they teach (M1 — see teacherMayPostAudience). Covers
        // absent alerts + resolved-leave for their own class, leave-submitted to
        // coordinator/principal, and class notices — without letting a teacher
        // address parents of OTHER classes.
        (isAnyTeacher()
          && 'audience' in request.resource.data
          && teacherMayPostAudience(request.resource.data.audience)) ||
        // Guardians: ONLY the legitimate student-leave notice addressed to their
        // OWN child's class teacher. Previously a guardian could post to
        // 'coordinator'/'principal' or 'guardian:<otherClass>:<roll>' with an
        // arbitrary title/body — an impersonation/phishing vector (review #5).
        (isRole('guardian')
          && 'audience' in request.resource.data
          && request.resource.data.audience == ('class_teacher:' + userStudentClass()))
      );

      // Editing/deleting an existing notice is a moderation action — management
      // only (a non-management member can no longer alter or remove notices).
      allow update, delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // TIMETABLE  (/schools/{sid}/timetable/{docId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/timetable/{docId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // SETTINGS  (/schools/{sid}/settings/{docId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/settings/{docId} {
      allow read:  if isSignedIn() && inSchool(sid) && (
        (docId != 'smtp' || isStrictAdmin()) &&
        (docId != 'keys' || isRootAdmin())
      );
      allow write: if isSignedIn() && inSchool(sid) && isManagement() && (
        (docId != 'keys' || isStrictAdmin())
      );

      match /entries/{entryId} {
        allow read:  if isSignedIn() && inSchool(sid) && (docId != 'changeLog' || isManagement());
        allow create: if isSignedIn() && inSchool(sid) && isManagement()
          && (docId != 'changeLog' || request.resource.data.changedBy == request.auth.uid);
        allow update, delete: if isSignedIn() && inSchool(sid) && isManagement() && docId != 'changeLog';
      }
    }


    // (Legacy un-scoped settings rule removed; migrated to scoped settings collection.)


    // ════════════════════════════════════════════════════════════════
    // DUTIES  (/schools/{sid}/duties/{docId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/duties/{docId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // SUBSTITUTIONS  (/schools/{sid}/substitutions/{docId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/substitutions/{docId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // HOMEWORK  (/schools/{sid}/homework/{docId})
    //
    // All school members may read; any teacher or management may write.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/homework/{docId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid)
        && (isManagement() || isAnyTeacher());
    }


    // ════════════════════════════════════════════════════════════════
    // AUDIT LOGS  (/schools/{sid}/audit_logs/{logId})
    //
    // APPEND-ONLY — once created, records are immutable for all users.
    //   Read:   principal | admin | owner | coordinator in school.
    //   Create: any authenticated school member (service layer only;
    //           fire-and-forget from service singletons).
    //   Update: admin/owner ONLY, and only to add a soft-delete reason
    //           (deletedReason, deletedAt, deletedBy fields). All other
    //           fields are locked.
    //   Delete: nobody — hard deletes are permanently forbidden.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/audit_logs/{logId} {

      allow read: if isSignedIn() && inSchool(sid)
        && hasAnyRole(['principal', 'admin', 'owner', 'ownerPrincipal', 'coordinator']);

      // Server-side only (#1): audit entries are written by the `writeAudit`
      // Cloud Function via the Admin SDK, which BYPASSES these rules. Direct
      // client creation is denied, so a user cannot forge entries under another
      // actor, spoof a role, or flood the log — the function stamps actor
      // identity from the verified token.
      //
      // ⚠ DEPLOY ORDER: deploy the writeAudit function (and ship the app build
      // that routes through it) BEFORE deploying this rule. The app keeps a
      // direct-write fallback that this `false` will (intentionally) deny once
      // live, so until both are out, leave this as the previous attributed-write
      // rule:
      //   allow create: if isSignedIn() && inSchool(sid)
      //     && request.resource.data.actorUid == request.auth.uid;
      allow create: if false;

      // Soft-delete only: admin may stamp a reason but cannot alter
      // any original audit fields (action, entity, before, after, etc.)
      allow update: if isSignedIn() && inSchool(sid)
        && isStrictAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['deletedReason', 'deletedAt', 'deletedBy']);

      allow delete: if false;
    }


    // ════════════════════════════════════════════════════════════════
    // REPORT CARD TEMPLATES  (/schools/{sid}/report_card_templates/{templateId})
    //
    // Read: all school members.
    // Write: coordinator | principal | admin | owner.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/report_card_templates/{templateId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // (The GALLERY feature — albums/photos — was removed from the app, so its
    // Firestore rules are deleted too; the default-deny catch-all covers any
    // residual schools/{sid}/albums or /photos docs.)


    // ════════════════════════════════════════════════════════════════
    // MEETINGS  (/schools/{sid}/meetings/{meetingId})
    //
    // Coordinator records: agenda, points, assigned teachers.
    // Read:  any staff member (records screens + assigned teachers).
    // Write: management (coordinator creates/edits/closes meetings).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/meetings/{meetingId} {
      allow read:  if isSignedIn() && inSchool(sid) && isAnyStaff();
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // MEETING TASKS  (/schools/{sid}/meetingTasks/{taskId})
    //
    // Tasks spun out of a meeting point onto a teacher.
    // Read:   assignee (assignedTo == uid) OR management.
    // Create/Delete: management only.
    // Update: management (full) or assignee (status field only).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/meetingTasks/{taskId} {

      // assignedTo holds the teacherId (MeetingService writes teacherId), so it
      // must be matched against userTeacherId() — NOT request.auth.uid, which is
      // a different value, so the assignee could never read/update their own
      // task (review #34). Mirrors the staff_tasks identity model.
      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        userTeacherId() == resource.data.assignedTo
      );

      allow create, delete: if isSignedIn() && inSchool(sid) && isManagement();

      allow update: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (userTeacherId() == resource.data.assignedTo
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status']))
      );
    }


    // ════════════════════════════════════════════════════════════════
    // PTM EVENTS  (/schools/{sid}/ptm_events/{eventId})
    //
    // Parent-Teacher Meeting events scheduled for a class.
    // Read: Any staff member OR guardians whose child is in the target class.
    // Write: Any staff member.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/ptm_events/{eventId} {
      allow read: if isSignedIn() && inSchool(sid) && (
        isAnyStaff() ||
        (isRole('guardian') && (
           resource.data.className == userStudentClass() ||
           ('classIds' in getUserData() && (
              resource.data.className in getUserData().classIds ||
              replaceSpaces(resource.data.className) in getUserData().classIds
           ))
        ))
      );
      allow write: if isSignedIn() && inSchool(sid) && isAnyStaff();
    }


    // ════════════════════════════════════════════════════════════════
    // LEADERBOARDS  (/schools/{sid}/leaderboards/{lbId} + /entries/{roll})
    //
    // Previously had NO rule → default-denied, feature dead (review #202).
    // Read: any school member (guardians see their child's class standings).
    // Write: management.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/leaderboards/{leaderboardId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();

      match /entries/{roll} {
        allow read:  if isSignedIn() && inSchool(sid);
        allow write: if isSignedIn() && inSchool(sid) && isManagement();
      }
    }


    // ════════════════════════════════════════════════════════════════
    // DROPDOWN OPTIONS  (/schools/{sid}/dropdown_options/{fieldKey})
    //
    // User-managed custom values for fee modes, leave types, etc.
    // (DropdownOptionsService). Previously had NO rule (review #285).
    // Read: any school member. Write: management.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/dropdown_options/{fieldKey} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // CALENDAR EVENTS  (/schools/{sid}/calendar_events/{eventId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/calendar_events/{eventId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // FEE REMINDERS  (/schools/{sid}/feeReminders/{reminderId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/feeReminders/{reminderId} {
      allow read:  if isSignedIn() && inSchool(sid) && isManagement();
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // UPI PAYMENT CLAIMS  (/schools/{sid}/payment_claims/{claimId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/payment_claims/{claimId} {
      allow read: if isSignedIn() && inSchool(sid) && isManagement();
      
      allow create: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isRole('guardian')
          && request.resource.data.status == 'pending'
          && (
             (request.resource.data.className == userStudentClass()
              && request.resource.data.section == userStudentSection()
              && request.resource.data.roll == userStudentRoll()) ||
             ('studentIds' in getUserData() && (
                replaceSpaces(request.resource.data.className) + '_' + string(request.resource.data.roll) in getUserData().studentIds ||
                replaceSpaces(request.resource.data.className) + '_' + replaceSpaces(request.resource.data.section) + '_' + string(request.resource.data.roll) in getUserData().studentIds
             ))
          )
          && request.resource.data.submittedBy == userEmail())
      );

      allow update: if isSignedIn() && inSchool(sid) && isManagement();

      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // EXPENSES  (/schools/{sid}/expenses/{expenseId})
    //
    // School-level expenses.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/expenses/{expenseId} {
      allow read, write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // ROOT COLLECTIONS used by legacy/util services.
    //
    // These are NOT school-scoped by path (cross-school) — a known tenancy
    // debt (review #245) to be addressed in the multi-tenancy pass by stamping
    // schoolId on each doc and filtering. For now they get explicit, role-gated
    // rules so the features stop silently failing under default-deny.
    // ════════════════════════════════════════════════════════════════

    // FCM device tokens (FirestoreService.saveFcmToken): users/{uid}.{fcmToken}
    // A user may only read/write their OWN token doc.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // (Legacy un-scoped calendar_events rule removed; migrated to scoped calendar_events collection.)

    // Substitution history (SubstitutionHistoryService).
    // Phase 3 tenancy: reads confined to the caller's school (schoolId stamped
    // Phase 1 + backfilled). Queries must add .where('schoolId', ...).
    match /substitution_history/{recordId} {
      allow read:  if isSignedIn() && isAnyStaff()
        && (isRootAdmin() || resource.data.schoolId == userSchoolId());
      allow write: if isSignedIn() && isManagement()
        && (isRootAdmin() || request.resource.data.schoolId == userSchoolId());
    }

    // (school_contacts rule removed — ContactService was deleted as dead code;
    // default-deny covers any residual docs.)

    // (Legacy un-scoped feeReminders rule removed; migrated to scoped feeReminders collection.)


    // ════════════════════════════════════════════════════════════════
    // COLLECTION-GROUP READS — remarks & payments
    //
    // The Principal EOD Digest fans out unscoped collectionGroup() queries
    // over every `remarks` (schools/{sid}/students/{id}/remarks) and
    // `payments` (fee_payments/{cls}/students/{roll}/payments) subcollection.
    // A collection-group query needs a rule that matches the leaf collection
    // at ANY depth via the recursive {path=**} wildcard.
    //
    // Restricted to management AND to the caller's own school: each leaf doc
    // carries a schoolId (Phase 1 writes + Phase 2 backfill), so a collection-
    // group query can no longer span schools (review #16). A management caller
    // must add .where('schoolId', isEqualTo: <their school>) for the query to
    // be permitted (rules are not filters). Root admin is exempt.
    // ════════════════════════════════════════════════════════════════
    match /{path=**}/remarks/{remarkId} {
      allow read: if isSignedIn() && isManagement()
        && (isRootAdmin() || resource.data.schoolId == userSchoolId());
    }

    match /{path=**}/payments/{paymentId} {
      allow read: if isSignedIn() && isManagement()
        && (isRootAdmin() || resource.data.schoolId == userSchoolId());
    }

  } // /databases/{database}/documents
} // service cloud.firestore
