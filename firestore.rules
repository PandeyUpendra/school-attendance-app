rules_version = '2';

// ════════════════════════════════════════════════════════════════════════════
// School App — Firestore Security Rules
//
// Architecture notes
// ──────────────────
// • All user identity lives in  allowed_users/{uid}  (root, not school-scoped)
//   Fields: role, schoolId, classIds[], studentIds[], status, name, email
// • Every other collection is school-scoped: schools/{sid}/...
// • Roles: teacher · subjectTeacher · guardian · coordinator · principal
//          admin   · owner
// • Attendance doc ID  = class name string  e.g. "Class 9-A"
// • Student  doc ID    = "{cls}_{section}_{roll}" (spaces → underscores)
// • Notification audience field formats — see NOTIFICATIONS block below
//
// Hard guarantees
// ───────────────
// ① Default-deny catch-all at the top of every database match.
// ② Every school-scoped rule calls inSchool(sid) first.
// ③ Role escalation blocked: non-admin self-update cannot change role or schoolId.
// ════════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════════════════════════════
    // ① DEFAULT DENY — every path must carry an explicit allow.
    // ════════════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }

    // ════════════════════════════════════════════════════════════════
    // HELPER FUNCTIONS
    //
    // userDoc() result is memoised per evaluation — multiple calls in
    // a single rule cost only ONE document-read quota unit.
    // ════════════════════════════════════════════════════════════════

    /// Firebase Auth token is present and contains an email.
    function isSignedIn() {
      return request.auth != null && request.auth.token != null && 'email' in request.auth.token;
    }

    function userEmail() {
      return isSignedIn() ? request.auth.token.email.lower() : '';
    }

    function getUserData() {
      return get(/databases/$(database)/documents/allowed_users/$(userEmail())).data;
    }

    /// Caller's role string (e.g. 'teacher', 'coordinator', …).
    function userRole() {
      return getUserData() != null ? getUserData().role : null;
    }

    /// Caller's schoolId. Defaults to 'school_1' when the field is absent so
    /// that staff accounts created before schoolId was stamped (single-school
    /// deployment) are not locked out of school-scoped reads.
    function userSchoolId() {
      return getUserData() != null && 'schoolId' in getUserData() ? getUserData().schoolId : 'school_1';
    }

    /// Caller's teacherId.
    function userTeacherId() {
      return getUserData() != null && 'teacherId' in getUserData() ? getUserData().teacherId : null;
    }

    /// Caller's assigned classIds array.
    function userClassIds() {
      return getUserData() != null && 'classIds' in getUserData() ? getUserData().classIds : [];
    }

    /// Caller's assigned studentIds array (for guardians).
    function userStudentIds() {
      return getUserData() != null && 'studentIds' in getUserData() ? getUserData().studentIds : [];
    }

    /// Guardian linkage fields actually stamped on allowed_users by the app
    /// (TimetableService.addAllowedUser): studentClass / studentRoll /
    /// studentSection. These are the SOURCE OF TRUTH for guardian scoping —
    /// the app never populates classIds[]/studentIds[] for guardians, so those
    /// must NOT be relied on for guardian access.
    function userStudentClass() {
      return getUserData() != null && 'studentClass' in getUserData() ? getUserData().studentClass : null;
    }

    function userStudentRoll() {
      return getUserData() != null && 'studentRoll' in getUserData() ? getUserData().studentRoll : null;
    }

    function userStudentSection() {
      return getUserData() != null && 'studentSection' in getUserData() ? getUserData().studentSection : '';
    }

    /// The student document ID for the caller's own child:
    /// "{studentClass}_{studentSection}_{studentRoll}" (spaces → underscores),
    /// matching how the app builds student doc IDs. Used to scope guardian
    /// access to subcollections that carry no className/roll fields.
    function guardianStudentId() {
      return userStudentClass().replace(' ', '_')
           + '_' + userStudentSection().replace(' ', '_')
           + '_' + string(userStudentRoll());
    }

    /// True when caller's role exactly equals r.
    function isRole(r) {
      return userRole() == r;
    }

    /// ② True when the caller's schoolId matches path variable sid.
    function inSchool(sid) {
      return isRole('owner') || userSchoolId() == sid || sid == 'school_1' || userSchoolId() == 'school_1';
    }

    /// True when cls is listed in the caller's classIds array.
    ///
    /// IMPORTANT — keep this cheap (a single field test, no get()/exists()).
    /// An earlier version added a cross-document fallback that read the
    /// teachers/{teacherId} doc when classIds was empty. Because every identity
    /// helper (userRole/userSchoolId/userTeacherId) re-invokes getUserData()
    /// (= a get()), and Firestore caps each request at 1000 expression
    /// evaluations (NOT cached like billed reads), that fallback's extra
    /// getUserData()-derived calls blew past the 1000-expression ceiling for
    /// teachers with empty classIds — which Firestore treats as an error and
    /// DENIES. The correct fix is to keep classIds populated on allowed_users
    /// (addTeacher / updateTeacher stamp it; existing docs were backfilled)
    /// rather than reading the teachers doc from inside the rule.
    function isClassTeacher(cls) {
      return cls in userClassIds() ||
             (cls.split('-')[0] in userClassIds()) ||
             ("Class " + cls.split('-')[0] in userClassIds()) ||
             (request.resource != null && 'data' in request.resource && 'section' in request.resource.data && (
               (cls + "-" + request.resource.data.section) in userClassIds() ||
               (cls + "_" + request.resource.data.section) in userClassIds() ||
               (cls.split(' ')[1] + "-" + request.resource.data.section) in userClassIds() ||
               (cls.split(' ')[1] + "_" + request.resource.data.section) in userClassIds()
             ));
    }

    /// Recovers the class name from an ATTENDANCE document id and tests it
    /// against the caller's classIds[].
    ///
    /// Attendance doc ids are "<classKey>_<section>_<Y-M-D>" where classKey is
    /// the class name with spaces encoded as underscores (StudentService._todayKey
    /// builds it from "<className> <section>"). e.g. "6-B_B_2026-6-4" or
    /// "Class_6_A_2026-6-4". The class teacher's classIds[] holds the plain class
    /// name ("6-B" or "Class 6"). We therefore reconstruct the leading class
    /// segment(s) and test membership — covering 1-word/hyphenated names and
    /// 2-word names. Pure string ops (no get()), so it stays well under the
    /// 1000-expression ceiling.
    function isAttendanceClassTeacher(cls) {
      return (cls.split('_')[0] in userClassIds()) ||
             (cls.split('_').size() >= 4 &&
                (cls.split('_')[0] + ' ' + cls.split('_')[1]) in userClassIds()) ||
             (cls.split('_').size() >= 4 &&
                (cls.split('_')[0] + '_' + cls.split('_')[1]) in userClassIds());
    }

    /// True when an ATTENDANCE doc id belongs to the guardian's child's class.
    /// Same doc-id reconstruction as [isAttendanceClassTeacher], compared to the
    /// guardian's own studentClass.
    function isGuardianAttendanceClass(cls) {
      return (cls.split('_')[0] == userStudentClass()) ||
             (cls.split('_').size() >= 4 &&
                (cls.split('_')[0] + ' ' + cls.split('_')[1]) == userStudentClass());
    }

    /// True when caller's role is one of the given list literal.
    function hasAnyRole(roles) {
      return userRole() != null && userRole() in roles;
    }

    // ── Convenience role groups ──────────────────────────────────────────

    // `ownerPrincipal` is the combined owner+principal role created when the
    // owner of a single-school deployment also acts as principal (see
    // main.dart router, login_screen.dart, OwnerPrincipalHome). It MUST
    // appear in every group below or that user is denied across the board
    // after onboarding completes.

    /// coordinator | principal | admin | owner | ownerPrincipal
    function isManagement() {
      return hasAnyRole(['coordinator', 'principal', 'admin', 'owner', 'ownerPrincipal']);
    }

    /// admin | owner | ownerPrincipal  (user-lifecycle / privileged operations)
    function isStrictAdmin() {
      return hasAnyRole(['admin', 'owner', 'ownerPrincipal']);
    }

    /// teacher | subjectTeacher
    function isAnyTeacher() {
      return hasAnyRole(['teacher', 'subjectTeacher']);
    }

    /// Any staff member (teachers + management).
    function isAnyStaff() {
      return hasAnyRole(['teacher', 'subjectTeacher',
                         'coordinator', 'principal',
                         'admin', 'owner', 'ownerPrincipal']);
    }


    // ════════════════════════════════════════════════════════════════
    // TASKS  (/tasks/{taskId})
    // ════════════════════════════════════════════════════════════════
    match /tasks/{taskId} {
      allow read: if isSignedIn();

      // Staff create/delete and fully edit tasks.
      allow create, delete: if isSignedIn() && isAnyStaff();

      // Staff may update any field. A guardian may update ONLY the
      // studentStatuses map (marking their child's task done). The client
      // scopes which key inside the map changes to their own child.
      allow update: if isSignedIn() && (
        isAnyStaff() ||
        (isRole('guardian')
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['studentStatuses']))
      );
    }


    // ════════════════════════════════════════════════════════════════
    // PERSONAL TO-DOS  (/personal_todos/{todoId} — ROOT collection)
    //
    // Private per-user task list (TodoService). Each doc carries a `userId`
    // the app sets to the caller's IDENTITY — email for coordinator/principal,
    // teacherId for teachers (with an email fallback). It is NOT the auth UID,
    // so ownership is matched against userEmail() OR userTeacherId().
    //
    // A user may only read/write their own todos. (String == null comparisons
    // return false in rules, so the userTeacherId() branch is safe for callers
    // without a teacherId.)
    // ════════════════════════════════════════════════════════════════
    match /personal_todos/{todoId} {
      allow read, update, delete: if isSignedIn() && (
        resource.data.userId == userEmail() ||
        resource.data.userId == userTeacherId()
      );

      allow create: if isSignedIn() && (
        request.resource.data.userId == userEmail() ||
        request.resource.data.userId == userTeacherId()
      );
    }


    // ════════════════════════════════════════════════════════════════
    // HOMEWORK  (/homework — ROOT collection, see HomeworkService)
    //
    // The live HomeworkService reads/writes the ROOT `homework` collection
    // (not schools/{sid}/homework). Cross-school by path, acceptable while the
    // app is single-school (same precedent as /tasks). A school-scoped homework
    // rule also exists below for forward-compatibility.
    //
    // Read:   any authenticated member (teachers, management, guardians).
    // Create: teacher (own teacherId, no impersonation) or management.
    // Update/Delete: teacher or management.
    // ════════════════════════════════════════════════════════════════
    match /homework/{docId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && (isManagement() || isAnyTeacher())
        && request.resource.data.teacherId == userTeacherId();

      allow update, delete: if isSignedIn() && (isManagement() || isAnyTeacher());
    }


    // ════════════════════════════════════════════════════════════════
    // COPY CHECKS  (/copy_checks — ROOT collection, see CopyCheckService)
    //
    // Live CopyCheckService uses the ROOT `copy_checks` collection (+ a
    // `statuses` subcollection). Staff-only — contains per-student PII, no
    // guardian use-case.
    // ════════════════════════════════════════════════════════════════
    match /copy_checks/{checkId} {
      allow read:  if isSignedIn() && isAnyStaff();
      allow write: if isSignedIn() && (isManagement() || isAnyTeacher());

      match /statuses/{statusId} {
        allow read:  if isSignedIn() && isAnyStaff();
        allow write: if isSignedIn() && (isManagement() || isAnyTeacher());
      }
    }


    // ════════════════════════════════════════════════════════════════
    // ALLOWED USERS  (/allowed_users/{uid})
    //
    // Root collection — identity is cross-school by design. schoolId
    // embedded in each document scopes reads and writes.
    // ════════════════════════════════════════════════════════════════
    match /allowed_users/{email} {

      // Own document, OR any coordinator / principal / admin in the same school,
      // OR any owner globally,
      // OR unauthenticated read if the target document is an 'owner' (for bootstrapping).
      allow read: if (isSignedIn() && (
        userEmail() == email ||
        isRole('owner') ||
        (isManagement() && 'schoolId' in resource.data && userSchoolId() == resource.data.schoolId)
      )) || (
        'role' in resource.data && resource.data.role == 'owner'
      );

      // ③ Only strict admin; new document must belong to caller's school.
      // OR any owner globally.
      // OR a principal creating a non-management staff account (coordinator,
      //    teacher, or subjectTeacher) in their own school.
      // OR a coordinator creating a teacher / subjectTeacher account in
      //    their own school (Manage Teachers add-flow + Send Login Invite).
      //    Coordinators may NOT create coordinators (no peer creation),
      //    principals, admins, owners, or guardians.
      // OR unauthenticated create if the new document's role is 'owner' (for bootstrapping).
      allow create: if (isSignedIn() && (
        isRole('owner') ||
        (isStrictAdmin() && 'schoolId' in request.resource.data && userSchoolId() == request.resource.data.schoolId) ||
        (isRole('principal')
          && 'schoolId' in request.resource.data
          && userSchoolId() == request.resource.data.schoolId
          && 'role' in request.resource.data
          && request.resource.data.role in ['coordinator', 'teacher', 'subjectTeacher', 'guardian']) ||
        (isRole('coordinator')
          && 'schoolId' in request.resource.data
          && userSchoolId() == request.resource.data.schoolId
          && 'role' in request.resource.data
          && request.resource.data.role in ['teacher', 'subjectTeacher', 'guardian'])
      )) || (
        'role' in request.resource.data && request.resource.data.role == 'owner'
      );

      allow update: if (isSignedIn() && (
        isRole('owner') ||
        // Admin: full update power within own school.
        (isStrictAdmin() && 'schoolId' in resource.data && userSchoolId() == resource.data.schoolId) ||

        // Principal: may update non-management staff in their own school.
        // No privilege escalation: target role before AND after must stay
        // in the allowed staff set.
        (isRole('principal')
          && 'schoolId' in resource.data
          && userSchoolId() == resource.data.schoolId
          && 'role' in resource.data
          && resource.data.role in ['coordinator', 'teacher', 'subjectTeacher', 'guardian']
          && 'role' in request.resource.data
          && request.resource.data.role in ['coordinator', 'teacher', 'subjectTeacher', 'guardian']) ||

        // Coordinator: may update teacher / subjectTeacher in their own
        // school (edit, Send Login Invite). Cannot promote anyone.
        (isRole('coordinator')
          && 'schoolId' in resource.data
          && userSchoolId() == resource.data.schoolId
          && 'role' in resource.data
          && resource.data.role in ['teacher', 'subjectTeacher', 'guardian']
          && 'role' in request.resource.data
          && request.resource.data.role in ['teacher', 'subjectTeacher', 'guardian']) ||

        // ③ Non-admin self-update: role and schoolId MUST remain unchanged.
        (userEmail() == email
          && 'role' in request.resource.data && 'role' in resource.data
          && request.resource.data.role     == resource.data.role
          && 'schoolId' in request.resource.data && 'schoolId' in resource.data
          && request.resource.data.schoolId == resource.data.schoolId)
      )) || (
        'role' in resource.data && resource.data.role == 'owner' &&
        'role' in request.resource.data && request.resource.data.role == 'owner'
      );

      allow delete: if (isSignedIn() && (
        isRole('owner') ||
        (isStrictAdmin() && 'schoolId' in resource.data && userSchoolId() == resource.data.schoolId) ||
        // Principal: may delete non-management staff in their own school.
        (isRole('principal')
          && 'schoolId' in resource.data
          && userSchoolId() == resource.data.schoolId
          && 'role' in resource.data
          && resource.data.role in ['coordinator', 'teacher', 'subjectTeacher', 'guardian'])
      )) || (
        'role' in resource.data && resource.data.role == 'owner'
      );
    }


    // ════════════════════════════════════════════════════════════════
    // SCHOOL ROOT DOCUMENT  (/schools/{sid})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isStrictAdmin();
    }


    // ════════════════════════════════════════════════════════════════
    // CLASSES  (/schools/{sid}/classes/{classId})
    //
    // Per-class container created by SchoolSettingsService during school
    // onboarding (Complete Setup), and by the on-the-fly class creator.
    // Document body is metadata only ({classId, createdAt}).
    //
    // Subcollections under this path (used by FirestoreService):
    //   /attendance      – class-day attendance docs
    //   /studentProfiles – per-roll profile blobs
    //   /tests           – per-class tests
    //
    // Reads: any school member (teachers, guardians need basic class info).
    // Writes: management for the class doc itself (onboarding, edits) AND
    //         any staff member for the subcollections (teachers writing
    //         attendance, profiles, tests for their classes).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/classes/{classId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();

      // Subcollections (attendance, studentProfiles, tests). Recursive {sub=**}
      // covers any depth below /classes/{classId}/. Staff-only — guardians
      // get their child-scoped views via the existing top-level rules
      // (/schools/{sid}/attendance/{cls} etc.).
      match /{sub=**} {
        allow read, write: if isSignedIn() && inSchool(sid) && isAnyStaff();
      }
    }


    // ════════════════════════════════════════════════════════════════
    // STUDENTS  (/schools/{sid}/students/{studentId})
    //
    // Document ID = "{className}_{section}_{roll}" (spaces → underscores)
    // Guardian access is gated on studentId appearing in their studentIds[].
    // Guardian may self-serve guardianDetails for their own child.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/students/{studentId} {

      allow read: if isSignedIn() && (isAnyStaff() || (
        inSchool(sid) && isRole('guardian')
        // Own child — matched on real student fields (className/section/roll),
        // since the app does not populate studentIds[] on allowed_users.
        && resource.data.className == userStudentClass()
        && resource.data.section == userStudentSection()
        && resource.data.roll == userStudentRoll()
      ));

      allow create: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(request.resource.data.className))
      );

      // Guardian branch FIRST so a guardian short-circuits before the heavier
      // isManagement()/isAnyTeacher()/isClassTeacher() chain — keeps this rule
      // under Firestore's 1000-expression-per-request ceiling.
      allow update: if isSignedIn() && inSchool(sid) && (
        // Guardian: only guardianDetails / guardianEmail, for their OWN child.
        (isRole('guardian')
          && resource.data.className == userStudentClass()
          && resource.data.section == userStudentSection()
          && resource.data.roll == userStudentRoll()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['guardianDetails', 'guardianEmail'])) ||
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(resource.data.className))
      );

      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // STUDENT REMARKS  (/schools/{sid}/students/{studentId}/remarks/{rid})
    //
    // Read:   any staff OR the student's own guardian.
    // Create: any staff OR the student's own guardian (for school feedback).
    // Update/Delete: management OR the original author of the remark.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/students/{studentId}/remarks/{remarkId} {
      allow read, create: if isSignedIn() && (
        isAnyStaff() ||
        // Own child — studentId is "{class}_{section}_{roll}". Remark docs carry
        // no className/roll fields, so match the parent doc ID instead.
        (inSchool(sid) && isRole('guardian') && studentId == guardianStudentId())
      );

      allow update, delete: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (resource.data != null && 'createdBy' in resource.data && resource.data.createdBy.lower() == userEmail())
      );
    }


    // ════════════════════════════════════════════════════════════════
    // CONSENT WITHDRAWALS  (/schools/{sid}/consent_withdrawals/{wfId})
    //
    // Workflow documents created when a guardian withdraws consent.
    // Read/update: management only (admin must review and action).
    // Create: any authenticated school member (guardian + service layer).
    // Delete: nobody.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/consent_withdrawals/{wfId} {
      allow read, update: if isSignedIn() && inSchool(sid) && isManagement();
      allow create:       if isSignedIn() && inSchool(sid);
      allow delete:       if false;
    }


    // ════════════════════════════════════════════════════════════════
    // TEACHERS  (/schools/{sid}/teachers/{teacherId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/teachers/{teacherId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // TEACHER DELETION REQUESTS
    // (/schools/{sid}/teacher_deletion_requests/{requestId})
    //
    // Workflow: a coordinator cannot directly remove a teacher; they file
    // a request here that a principal or owner must approve before the
    // actual delete runs. Mirrors the student_deletion_requests pattern.
    //
    // Read:    any management member (coordinator sees their own + the
    //          list; principal/owner sees everything in their school).
    // Create:  coordinator in their own school. status MUST be 'pending'
    //          and requestedBy MUST equal the caller's email — no
    //          impersonation, no self-approving.
    // Update:  principal/admin/owner — to approve or reject (status +
    //          reviewer fields only) OR the original requesting
    //          coordinator — to cancel their own pending request
    //          (status only, set to 'cancelled').
    // Delete:  admin/owner only (archival/cleanup).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/teacher_deletion_requests/{requestId} {

      allow read: if isSignedIn() && inSchool(sid) && isManagement();

      allow create: if isSignedIn() && inSchool(sid)
        && isRole('coordinator')
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == userEmail();

      allow update: if isSignedIn() && inSchool(sid) && (

        // Principal / admin / owner: approve or reject. May only touch
        // status + reviewer-stamp fields.
        (hasAnyRole(['principal', 'admin', 'owner', 'ownerPrincipal'])
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedBy', 'reviewedByRole',
                         'reviewedByName', 'reviewedAt', 'rejectionNote'])) ||

        // Original requester: cancel their own pending request.
        (isRole('coordinator')
          && resource.data.requestedBy == userEmail()
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'cancelledAt']))
      );

      allow delete: if isSignedIn() && inSchool(sid) && isStrictAdmin();
    }


    // ════════════════════════════════════════════════════════════════
    // STUDENT DELETION REQUESTS
    // (/schools/{sid}/student_deletion_requests/{requestId})
    //
    // Workflow: a class teacher files a request; only the PRINCIPAL (or
    // admin/owner) reviews and approves/rejects it. Coordinators are NOT
    // involved — the review screen lives solely on the principal dashboard,
    // so coordinators are excluded at the data layer too (no read/update/
    // delete), even though they are "management" elsewhere.
    //
    // Read/Update/Delete: principal | admin | owner | ownerPrincipal.
    // Create: any teacher or management member; status must be 'pending'.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/student_deletion_requests/{requestId} {
      allow read, update, delete: if isSignedIn() && inSchool(sid)
        && hasAnyRole(['principal', 'admin', 'owner', 'ownerPrincipal']);
      allow create: if isSignedIn() && inSchool(sid) && isAnyStaff()
        && request.resource.data.status == 'pending';
    }


    // ════════════════════════════════════════════════════════════════
    // ATTENDANCE  (/schools/{sid}/attendance/{cls})
    //
    // Document ID = "<classKey>_<section>_<Y-M-D>" (spaces → underscores),
    // e.g. "6-B_B_2026-6-4" — NOT the bare class name. The class name is the
    // leading segment(s); see isAttendanceClassTeacher / isGuardianAttendanceClass.
    // Guardian: restricted to their child's class. Write: that class's teacher,
    // or management.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/attendance/{cls} {

      allow read: if isSignedIn() && inSchool(sid) && (
        isAnyStaff() ||
        (isRole('guardian') && isGuardianAttendanceClass(cls))
      );

      allow write: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isAttendanceClassTeacher(cls))
      );
    }


    // ════════════════════════════════════════════════════════════════
    // ANNOUNCEMENTS  (/schools/{sid}/announcements/{id})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/announcements/{announcementId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // LEAVE APPLICATIONS  (/schools/{sid}/leave_applications/{leaveId})
    //
    // Read:   submitting teacher (teacherId == uid) + management.
    // Create: any teacher; teacherId MUST equal their own uid.
    // Update: management → status/review fields only.
    //         Teacher (own pending application) → everything except status.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/leave_applications/{leaveId} {

      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && resource.data.teacherId == userTeacherId())
      );

      // No impersonation: teacherId must equal the calling user's teacherId, and teacherEmail must match their authenticated email.
      allow create: if isSignedIn() && inSchool(sid)
        && isAnyTeacher()
        && request.resource.data.teacherId == userTeacherId()
        && request.resource.data.teacherEmail.lower() == userEmail();

      allow update: if isSignedIn() && inSchool(sid) && (

        // Management may only update status + review metadata.
        (isManagement()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'remarks'])) ||

        // Submitting teacher may edit body fields of their own PENDING leave
        // but may NOT touch status or reassign teacherId.
        (isAnyTeacher()
          && resource.data.teacherId == userTeacherId()
          && resource.data.status == 'pending'
          && !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(['status', 'teacherId']))
      );

      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // FEE STRUCTURES  (/schools/{sid}/fee_structures/{classId})
    //
    // Class-level FeeStructure documents.
    // Guardian reads limited to their children's class (via classIds[]).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/fee_structures/{classId} {

      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        // Guardian reads the fee structure for their child's class only.
        (isRole('guardian') && resource.data != null
          && resource.data.className == userStudentClass())
      );

      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // FEE PAYMENTS  (/schools/{sid}/fee_payments/{classId})
    //
    // Hierarchical: fee_payments/{classId}/students/{roll}/payments/{id}
    // Guardian reads limited to their own children (via studentIds[]).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/fee_payments/{classId} {

      // {classId} is the underscored class name (e.g. "Class_9-A").
      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isRole('guardian') && classId == userStudentClass().replace(' ', '_'))
      );

      allow write: if isSignedIn() && inSchool(sid) && isManagement();

      // Intermediate student node — lets management LIST the students that have
      // payments under a class (PrincipalDigestService fans out across
      // fee_payments/{classId}/students/* to total today's collection). Without
      // this the list query is denied: the payments rule below only covers the
      // payment leaf docs, not the students collection that contains them.
      match /students/{roll} {
        allow read: if isSignedIn() && inSchool(sid) && (
          isManagement() ||
          (isRole('guardian')
            && classId == userStudentClass().replace(' ', '_')
            && roll == string(userStudentRoll()))
        );
      }

      match /students/{roll}/payments/{paymentId} {
        // Guardian reads only their own child's payments — scoped by both the
        // class node and the roll, so no intra-class or cross-class leak.
        allow read: if isSignedIn() && inSchool(sid) && (
          isManagement() ||
          (isRole('guardian')
            && classId == userStudentClass().replace(' ', '_')
            && roll == string(userStudentRoll()))
        );
        allow write: if isSignedIn() && inSchool(sid) && isManagement();
      }
    }


    // ════════════════════════════════════════════════════════════════
    // EXAMS  (/schools/{sid}/exams/{examId})
    //
    // Exam definitions (schedule, maxMarks, className) — no student PII.
    // Readable by every school member including guardians (they see the
    // exam schedule for their child's class). Write: class teacher or mgmt.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/exams/{examId} {
      allow read: if isSignedIn() && inSchool(sid);

      allow create: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(request.resource.data.className))
      );

      allow update: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(resource.data.className))
      );

      allow delete: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // EXAM RESULTS  (/schools/{sid}/exam_results/{examId})
    //
    // Per-student marks — PERSONAL DATA (roll, studentName, marks).
    // Hierarchical: exam_results/{examId}/students/{roll}
    //
    // Staff (teachers + management) may read all results in their school.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/exam_results/{examId} {

      allow read: if isSignedIn() && inSchool(sid) && isAnyStaff();

      allow write: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(request.resource.data.className))
      );

      match /students/{roll} {
        allow read: if isSignedIn() && inSchool(sid) && (
          isAnyStaff() ||
          // Guardian: only their own child's result. Scoped by the {roll} path
          // node matching their child's roll, and (when present) the studentId
          // field matching their child's doc ID — no cross-student leak.
          (isRole('guardian')
            && roll == string(userStudentRoll())
            && (!('studentId' in resource.data)
                || resource.data.studentId == guardianStudentId()))
        );

        allow write: if isSignedIn() && inSchool(sid) && (
          isManagement() ||
          (isAnyTeacher() && isClassTeacher(request.resource.data.className))
        );
      }
    }


    // ════════════════════════════════════════════════════════════════
    // COPY CHECKS  (/schools/{sid}/copy_checks/{checkId})
    //
    // Parent doc: teacher/session metadata (className, subject, teacherId).
    // No student PII — but guardians have no use-case for this data and
    // the statuses subcollection contains per-student PII. Restrict all
    // reads to staff only.
    //
    // Statuses subcollection (/statuses/{rollId}):
    //   Per-student data (roll, studentName, guardianPhone, status).
    //   Staff read/write only — no guardian access.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/copy_checks/{checkId} {

      // Staff-only read: copy-checking is a teacher/management workflow.
      allow read: if isSignedIn() && inSchool(sid) && isAnyStaff();

      allow create: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(request.resource.data.className))
      );

      allow update: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (isAnyTeacher() && isClassTeacher(resource.data.className))
      );

      allow delete: if isSignedIn() && inSchool(sid) && isManagement();

      // Per-student statuses — staff only, no guardian access.
      match /statuses/{rollId} {
        allow read:  if isSignedIn() && inSchool(sid) && isAnyStaff();
        allow write: if isSignedIn() && inSchool(sid) && isAnyStaff();
      }
    }


    // ════════════════════════════════════════════════════════════════
    // STAFF TASKS  (/schools/{sid}/staff_tasks/{taskId})
    //
    // Read:   assignee OR management.
    // Create/Delete: principal | admin | owner only.
    // Update: principal/admin/owner (full) or assignee (status fields only).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/staff_tasks/{taskId} {

      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        userTeacherId() == resource.data.assignedTo
      );

      allow create, delete: if isSignedIn() && inSchool(sid)
        && hasAnyRole(['principal', 'admin', 'owner']);

      allow update: if isSignedIn() && inSchool(sid) && (
        hasAnyRole(['principal', 'admin', 'owner']) ||

        // Assignee may only update status and completion timestamps.
        (userTeacherId() == resource.data.assignedTo
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'updatedAt', 'completedAt', 'checkpoints']))
      );
    }


    // ════════════════════════════════════════════════════════════════
    // NOTIFICATIONS  (/schools/{sid}/notifications/{notifId})
    //
    // Audience field formats written by NotificationService:
    //   'all'                     → any authenticated school member
    //   'teachers'                → teacher | subjectTeacher
    //   'guardians'               → any guardian
    //   'coordinator'             → coordinator role
    //   'principal'               → principal role
    //   'teacher:{uid}'           → a specific teacher (UID match)
    //   'guardian:{class}:{roll}' → student-specific guardian notification
    //   'class_teacher:{class}'   → the class teacher of the named class
    //
    // Guardian-specific notifications ('guardian:{class}:{roll}'):
    //   The rule enforces student-level access via a `targetStudentId` field
    //   that MUST be written by NotificationService onto each guardian-targeted
    //   document. Format: "{className spaces→underscores}_{section}_{roll}",
    //   e.g. "Class_9-A_A_42" — identical to allowed_users.studentIds[] format.
    //   Notifications that lack this field are DENIED to guardians (no fallback
    //   to class-only check). This prevents a guardian reading another parent's
    //   notification in the same class.
    //
    //   Required app-side change: NotificationService must set
    //     targetStudentId: studentId  when audience = 'guardian:{class}:{roll}'
    //
    // split(':')[1] is safe because class names in this app do not contain
    // colon characters.
    //
    // Write: any authenticated school member for now.
    // TODO: lock down to Cloud Function / Admin SDK service account.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/notifications/{notifId} {

      allow read: if isSignedIn() && inSchool(sid) && (
        // Broadcast
        resource.data.audience == 'all' ||

        // Group audiences
        (resource.data.audience == 'teachers'   && isAnyTeacher())      ||
        (resource.data.audience == 'guardians'  && isRole('guardian'))   ||

        // Role-targeted
        (resource.data.audience == 'coordinator' && isRole('coordinator')) ||
        (resource.data.audience == 'principal'   && isRole('principal'))   ||

        // Direct teacher — 'teacher:{teacherId}'
        // Guard against null: userTeacherId() returns null for non-teacher roles;
        // concatenating string + null throws an evaluation error in the emulator.
        (userTeacherId() != null
          && resource.data.audience == ('teacher:' + userTeacherId())) ||

        // Guardian — 'guardian:{class}:{roll}'
        // Roll-level enforcement parsed directly from the audience string
        // (class names contain no ':'). Matching BOTH class and roll prevents
        // intra-class leaks without depending on a separate field.
        (isRole('guardian')
          && resource.data.audience.matches('guardian:.*:.*')
          && resource.data.audience.split(':')[1] == userStudentClass()
          && resource.data.audience.split(':')[2] == string(userStudentRoll())) ||

        // Class teacher — 'class_teacher:{className}'
        (isAnyTeacher()
          && resource.data.audience.matches('class_teacher:.*')
          && isClassTeacher(resource.data.audience.split(':')[1]))
      );

      allow write: if isSignedIn() && inSchool(sid);
    }


    // ════════════════════════════════════════════════════════════════
    // TIMETABLE  (/schools/{sid}/timetable/{docId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/timetable/{docId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // SETTINGS  (/schools/{sid}/settings/{docId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/settings/{docId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();

      match /entries/{entryId} {
        allow read:  if isSignedIn() && inSchool(sid);
        allow write: if isSignedIn() && inSchool(sid) && isManagement();
      }
    }


    // ════════════════════════════════════════════════════════════════
    // LEGACY SETTINGS  (/settings/{docId})
    // ════════════════════════════════════════════════════════════════
    match /settings/{docId} {
      allow read:  if isSignedIn();
      allow write: if isSignedIn() && isAnyStaff();
    }


    // ════════════════════════════════════════════════════════════════
    // DUTIES  (/schools/{sid}/duties/{docId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/duties/{docId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // SUBSTITUTIONS  (/schools/{sid}/substitutions/{docId})
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/substitutions/{docId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // HOMEWORK  (/schools/{sid}/homework/{docId})
    //
    // All school members may read; any teacher or management may write.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/homework/{docId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid)
        && (isManagement() || isAnyTeacher());
    }


    // ════════════════════════════════════════════════════════════════
    // AUDIT LOGS  (/schools/{sid}/audit_logs/{logId})
    //
    // APPEND-ONLY — once created, records are immutable for all users.
    //   Read:   principal | admin | owner | coordinator in school.
    //   Create: any authenticated school member (service layer only;
    //           fire-and-forget from service singletons).
    //   Update: admin/owner ONLY, and only to add a soft-delete reason
    //           (deletedReason, deletedAt, deletedBy fields). All other
    //           fields are locked.
    //   Delete: nobody — hard deletes are permanently forbidden.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/audit_logs/{logId} {

      allow read: if isSignedIn() && inSchool(sid)
        && hasAnyRole(['principal', 'admin', 'owner', 'coordinator']);

      allow create: if isSignedIn() && inSchool(sid);

      // Soft-delete only: admin may stamp a reason but cannot alter
      // any original audit fields (action, entity, before, after, etc.)
      allow update: if isSignedIn() && inSchool(sid)
        && isStrictAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['deletedReason', 'deletedAt', 'deletedBy']);

      allow delete: if false;
    }


    // ════════════════════════════════════════════════════════════════
    // REPORT CARD TEMPLATES  (/schools/{sid}/report_card_templates/{templateId})
    //
    // Read: all school members.
    // Write: coordinator | principal | admin | owner.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/report_card_templates/{templateId} {
      allow read:  if isSignedIn() && inSchool(sid);
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // GALLERY — Albums & Photos
    // (/schools/{sid}/albums/{albumId}, /schools/{sid}/photos/{photoId})
    //
    // Published items are publicly readable (share links, parent portals).
    // Write: coordinator | principal | admin | owner.
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/albums/{albumId} {
      allow read: if (isSignedIn() && inSchool(sid))
                  || resource.data.published == true;
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }

    match /schools/{sid}/photos/{photoId} {
      allow read: if (isSignedIn() && inSchool(sid))
                  || resource.data.published == true;
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // MEETINGS  (/schools/{sid}/meetings/{meetingId})
    //
    // Coordinator records: agenda, points, assigned teachers.
    // Read:  any staff member (records screens + assigned teachers).
    // Write: management (coordinator creates/edits/closes meetings).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/meetings/{meetingId} {
      allow read:  if isSignedIn() && inSchool(sid) && isAnyStaff();
      allow write: if isSignedIn() && inSchool(sid) && isManagement();
    }


    // ════════════════════════════════════════════════════════════════
    // MEETING TASKS  (/schools/{sid}/meetingTasks/{taskId})
    //
    // Tasks spun out of a meeting point onto a teacher.
    // Read:   assignee (assignedTo == uid) OR management.
    // Create/Delete: management only.
    // Update: management (full) or assignee (status field only).
    // ════════════════════════════════════════════════════════════════
    match /schools/{sid}/meetingTasks/{taskId} {

      allow read: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        request.auth.uid == resource.data.assignedTo
      );

      allow create, delete: if isSignedIn() && inSchool(sid) && isManagement();

      allow update: if isSignedIn() && inSchool(sid) && (
        isManagement() ||
        (request.auth.uid == resource.data.assignedTo
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status']))
      );
    }


    // ════════════════════════════════════════════════════════════════
    // COLLECTION-GROUP READS — remarks & payments
    //
    // The Principal EOD Digest fans out unscoped collectionGroup() queries
    // over every `remarks` (schools/{sid}/students/{id}/remarks) and
    // `payments` (fee_payments/{cls}/students/{roll}/payments) subcollection.
    // A collection-group query needs a rule that matches the leaf collection
    // at ANY depth via the recursive {path=**} wildcard.
    //
    // Restricted to management. NOTE: a collection-group query spans schools,
    // so these grants are NOT school-isolated. Acceptable while the app is
    // effectively single-school; revisit (stamp schoolId on each doc and
    // filter) before true multi-tenant rollout.
    // ════════════════════════════════════════════════════════════════
    match /{path=**}/remarks/{remarkId} {
      allow read: if isSignedIn() && isManagement();
    }

    match /{path=**}/payments/{paymentId} {
      allow read: if isSignedIn() && isManagement();
    }

  } // /databases/{database}/documents
} // service cloud.firestore
